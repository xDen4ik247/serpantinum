#!/usr/bin/env python3
"""Turn the touchpad's disable-while-typing (libinput dwt) OFF while a game is focused.

niri has no per-window dwt, so this daemon flips the `dwt` line of the touchpad
section in ~/.config/niri/user/input.kdl (niri hot-reloads its config).

A focused window counts as a game when (generic, no app names built in):
  * it covers its whole output (fullscreen, or borderless window sized to the output), or
  * it matches a pattern in the optional override file (see below).

Event-driven only: it listens to `niri msg -j event-stream`, never polls, and only
writes the config when the wanted state actually changes. On exit (niri quits,
SIGTERM, error) it restores `dwt`.

Override file: ~/.config/niri-dwt-toggle/overrides.conf (re-read when it changes)
    # one Python regex per line, matched (case-insensitive) against the app_id;
    # prefix with "title:" to match the window title instead
    ^steam_app_          -> always a game, even windowed (dwt off)
    !^mpv$               -> never a game, even fullscreen (dwt stays on)
First matching line wins.
"""
import fcntl, json, os, re, select, signal, subprocess, sys, time

CFG = os.path.expanduser("~/.config/niri/user/input.kdl")
OVERRIDES = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                         "niri-dwt-toggle", "overrides.conf")
DWT_RE = re.compile(r"^([ \t]*)(?://[ \t]*)?dwt[ \t]*$", re.M)
TOLERANCE = 2      # logical px of slack when comparing a window to its output
DEBOUNCE = 0.25    # s; collapses resize/focus bursts into one config write
VERBOSE = "-v" in sys.argv


def log(*a):
    print("niri-dwt-toggle:", *a, file=sys.stderr, flush=True)


# ---------- config file ----------
def file_dwt_state():
    """True/False = current dwt line state, None = no dwt line found."""
    try:
        with open(CFG) as f:
            m = DWT_RE.search(f.read())
    except OSError:
        return None
    return None if not m else not m.group(0).lstrip().startswith("//")


def set_dwt(on: bool):
    # Re-read right before writing; touch nothing but the dwt line.
    try:
        with open(CFG) as f:
            text = f.read()
    except OSError as e:
        log("cannot read", CFG, e)
        return
    new = DWT_RE.sub(lambda m: m.group(1) + ("dwt" if on else "// dwt"), text, count=1)
    if new != text:
        with open(CFG, "w") as f:
            f.write(new)
        log("dwt", "ON" if on else "OFF (game focused)")


# ---------- overrides ----------
_ov_mtime = None
_ov_rules = []  # (negate, field, regex)


def overrides():
    global _ov_mtime, _ov_rules
    try:
        mt = os.stat(OVERRIDES).st_mtime_ns
    except OSError:
        mt = None
    if mt == _ov_mtime:
        return _ov_rules
    _ov_mtime, rules = mt, []
    if mt is not None:
        with open(OVERRIDES) as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#"):
                    continue
                neg = ln.startswith("!")
                ln = ln[1:].strip() if neg else ln
                field = "app_id"
                if ln.startswith("title:"):
                    field, ln = "title", ln[6:].strip()
                try:
                    rules.append((neg, field, re.compile(ln, re.I)))
                except re.error as e:
                    log("bad pattern in", OVERRIDES, repr(ln), e)
    _ov_rules = rules
    return rules


# ---------- niri state ----------
windows, workspaces, outputs = {}, {}, {}
focused = None


def load_outputs():
    global outputs
    try:
        out = subprocess.run(["niri", "msg", "-j", "outputs"], capture_output=True, text=True, timeout=5).stdout
        outputs = {name: (o["logical"]["width"], o["logical"]["height"])
                   for name, o in json.loads(out).items() if o.get("logical")}
    except Exception as e:
        log("cannot read outputs:", e)


def covers_output(w):
    ws = workspaces.get(w.get("workspace_id"))
    size = outputs.get(ws.get("output")) if ws else None
    if not size:
        return False
    lay = w.get("layout") or {}
    for key in ("window_size", "tile_size"):
        s = lay.get(key)
        if s and s[0] >= size[0] - TOLERANCE and s[1] >= size[1] - TOLERANCE:
            return True
    return False


def is_game(w):
    for neg, field, rx in overrides():
        if rx.search(w.get(field) or ""):
            return not neg
    return covers_output(w)


def wanted_dwt():
    w = windows.get(focused)
    return not (w and is_game(w))


# ---------- main loop ----------
def main():
    global windows, workspaces, focused
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "niri-dwt-toggle.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("already running")
        return

    def bye(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGHUP, bye)

    load_outputs()
    applied = file_dwt_state()
    pending, due = None, 0.0
    proc = subprocess.Popen(["niri", "msg", "-j", "event-stream"], stdout=subprocess.PIPE)
    fd, buf = proc.stdout.fileno(), b""
    try:
        while True:
            timeout = max(0.0, due - time.monotonic()) if pending is not None else None
            r, _, _ = select.select([fd], [], [], timeout)
            if not r:  # debounce elapsed
                if pending != applied:
                    set_dwt(pending)
                    applied = pending
                pending = None
                continue
            chunk = os.read(fd, 65536)
            if not chunk:
                log("event stream closed")
                break
            buf += chunk
            *lines, buf = buf.split(b"\n")
            for line in lines:
                if not line.strip():
                    continue
                ev = json.loads(line)
                if "WindowsChanged" in ev:
                    windows = {w["id"]: w for w in ev["WindowsChanged"]["windows"]}
                    focused = next((w["id"] for w in windows.values() if w.get("is_focused")), None)
                elif "WindowOpenedOrChanged" in ev:
                    w = ev["WindowOpenedOrChanged"]["window"]
                    windows[w["id"]] = w
                    if w.get("is_focused"):
                        focused = w["id"]
                    elif focused == w["id"]:
                        focused = None
                elif "WindowClosed" in ev:
                    windows.pop(ev["WindowClosed"]["id"], None)
                elif "WindowFocusChanged" in ev:
                    focused = ev["WindowFocusChanged"]["id"]
                elif "WindowLayoutsChanged" in ev:
                    for wid, lay in ev["WindowLayoutsChanged"]["changes"]:
                        if wid in windows:
                            windows[wid]["layout"] = lay
                elif "WorkspacesChanged" in ev:
                    workspaces = {ws["id"]: ws for ws in ev["WorkspacesChanged"]["workspaces"]}
                    if any(ws.get("output") and ws["output"] not in outputs for ws in workspaces.values()):
                        load_outputs()
                elif "ConfigLoaded" in ev:
                    load_outputs()  # scale/mode may have changed
                    applied = file_dwt_state()  # the file may have been edited by hand
                else:
                    continue
                want = wanted_dwt()
                if VERBOSE:
                    log("event", next(iter(ev)), "focused", focused, "want dwt", want)
                if want != applied:
                    if pending != want:
                        pending, due = want, time.monotonic() + DEBOUNCE
                else:
                    pending = None
    finally:
        try:
            proc.terminate()
        except Exception:
            pass
        set_dwt(True)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
