#!/usr/bin/python3
"""music-smart — My Vibe: one play button that starts good music from the MPD library.

    music-smart [start] [STYLE]  start My Vibe in STYLE (default: the last style you used);
                                 when it already plays, re-roll it within the same style
    music-smart reroll       a fresh queue in the current style
    music-smart stop         leave My Vibe (the queue and playback stay as they are)
    music-smart styles [--json]   the styles and how many songs each one can draw from
    music-smart why          explain why the current track was picked   (alias: explain-why)
    music-smart stats        what the history has learned so far
    music-smart fav [on|off|toggle] [FILE]   mark the current (or given) track as a favourite
    music-smart ban|unban [FILE]             never play it in My Vibe (or allow it again)
    music-smart status       one line (or --json) about My Vibe
    music-smart seed         (re)import past plays from MPD's journal
    music-smart daemon       the event-driven logger + queue keeper (music-smart.service)

Styles (each one is an endless smart queue that tops itself up):
  · My Vibe (default)  what you play most: play counts, recency and skips from your history,
                       favourites, with every fourth pick left to chance so it never gets stale
  · Favourites         only the songs you starred
  · Discover           songs and artists you rarely or never play
  · Reggae             roots, dub, dancehall, ska, rocksteady… found from genre tags, artists
                       whose songs are mostly tagged that way, and song/album titles
  · the moods          Heavy, Rock, Alt & indie, Rap, Electronic, Pop, Chill (from genre tags)
  Optional local overrides and extra styles: ~/.config/glass-music/styles.json, e.g.
    {"reggae": {"artists": ["Some Artist"], "exclude_files": ["Artist/Album"]},
     "night":  {"label": "Night drive", "genres": ["synthwave"], "artists": ["…"]}}
  Keys per style: genres, artists, files (path prefixes relative to the music directory) and
  exclude_genres / exclude_artists / exclude_files; extra styles may set label, desc, icon.

The whole library counts as liked; a favourite (MPD sticker "favourite") is the lighter, stronger
signal on top, and "ban" means never play. Old "love" stickers are migrated to favourites.

The daemon blocks on MPD's idle protocol (no polling): it logs every play into
~/.local/share/music-smart/history.sqlite, tops the queue up as it drains, and writes
~/.local/state/music-smart/state.json (bar, music panel, Glass Music) and styles.json (the
song lists of the styles, for Glass Music) whenever something changes.
"""

import json
import math
import os
import random
import re
import socket
import sqlite3
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
DATA_DIR = os.path.join(os.environ.get("XDG_DATA_HOME", HOME + "/.local/share"), "music-smart")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "music-smart")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "glass-music")
DB_PATH = os.path.join(DATA_DIR, "history.sqlite")
STATE_PATH = os.path.join(STATE_DIR, "state.json")
POOLS_PATH = os.path.join(STATE_DIR, "styles.json")
USER_STYLES = os.path.join(CONFIG_DIR, "styles.json")
CHANNEL = "music-smart"

QUEUE_SIZE = 50        # tracks in a fresh queue
TOPUP_BELOW = 12       # top up when fewer than this many tracks are left after the current one
TOPUP_COUNT = 25
KEEP_PLAYED = 15       # already-played tracks kept above the current one
ARTIST_WINDOW = 3      # no artist repeats within this many tracks

FAV = "favourite"      # MPD sticker names
OLD_LOVE = "love"
BAN = "ban"

# ── moods ────────────────────────────────────────────────────────────────────
MOODS = ["heavy", "rock", "alt", "rap", "electronic", "pop", "chill"]
MOOD_LABEL = {"heavy": "Heavy", "rock": "Rock", "alt": "Alt & indie", "rap": "Rap",
              "electronic": "Electronic", "pop": "Pop", "chill": "Chill"}
# Genre ids (as streaming services tag them) → mood; first matching substring wins (order matters).
GENRE_RULES = [
    ("metal", "heavy"), ("core", "heavy"), ("thrash", "heavy"), ("doom", "heavy"),
    ("hardrock", "heavy"), ("stoner", "heavy"), ("grunge", "heavy"),
    ("triphop", "chill"), ("jazz", "chill"), ("bebop", "chill"), ("bigband", "chill"),
    ("lounge", "chill"), ("relax", "chill"), ("newage", "chill"), ("ambient", "chill"),
    ("classical", "chill"), ("soundtrack", "chill"), ("films", "chill"), ("videogame", "chill"),
    ("bard", "chill"), ("folk", "chill"), ("country", "chill"), ("reggaeton", "pop"), ("reggae", "chill"),
    ("soul", "chill"), ("blues", "chill"), ("jewish", "chill"), ("chill", "chill"),
    ("hyperpop", "rap"), ("phonk", "rap"), ("rap", "rap"), ("hiphop", "rap"), ("trap", "rap"),
    ("edm", "electronic"), ("house", "electronic"), ("electron", "electronic"), ("idm", "electronic"),
    ("breakbeat", "electronic"), ("techno", "electronic"), ("trance", "electronic"),
    ("dnb", "electronic"), ("dubstep", "electronic"), ("synth", "electronic"),
    ("postpunk", "alt"), ("alternative", "alt"), ("indie", "alt"), ("experimental", "alt"),
    ("modern", "alt"), ("shoegaze", "alt"),
    ("punk", "rock"), ("rock", "rock"), ("rnr", "rock"), ("prog", "rock"), ("ska", "rock"),
    ("rnb", "pop"), ("funk", "pop"), ("disco", "pop"), ("dance", "pop"), ("estrada", "pop"),
    ("latin", "pop"), ("pop", "pop"), ("sport", "pop"),
]

# ── styles ───────────────────────────────────────────────────────────────────
# id, label, one-line description, icon name (the UIs map it to a glyph)
BUILTIN_STYLES = [
    ("default", "My Vibe", "What you play most, with room for surprises", "vibe"),
    ("favourites", "Favourites", "Only the songs you starred", "star"),
    ("discover", "Discover", "Songs and artists you rarely play", "compass"),
    ("reggae", "Reggae", "Roots, dub, dancehall, ska and rocksteady", "reggae"),
    ("heavy", "Heavy", "Metal, hardcore and heavy rock", "heavy"),
    ("rock", "Rock", "Rock, punk and prog", "rock"),
    ("alt", "Alt & indie", "Alternative, indie and post-punk", "alt"),
    ("rap", "Rap", "Rap, hip-hop and phonk", "rap"),
    ("electronic", "Electronic", "House, techno, IDM and friends", "electronic"),
    ("pop", "Pop", "Pop, R&B, funk and dance", "pop"),
    ("chill", "Chill", "Jazz, soul, folk and calmer songs", "chill"),
]
WHOLE_LIBRARY = ("default", "discover")      # styles that draw from every song

# Reggae from genre tags (normalised: lower case, no spaces / dashes / underscores).
# "reggaeton" is Latin pop, "dubstep" / "dub techno" are electronic: not reggae.
REGGAE_GENRE = re.compile(r"reggae(?!ton)|^dub(?!step|techno)|dancehall|^ska|rocksteady|ragga|loversrock|^roots")
# …and from titles / album names (generic words only).
REGGAE_WORDS = re.compile(r"\b(?:reggae|rasta\w*|dancehall|rocksteady|jamaica\w*|jah)\b|регги|раста\w*|ямайк|джамайк",
                          re.I)

BUCKETS = [("night", 0, 6), ("morning", 6, 12), ("day", 12, 18), ("evening", 18, 24)]
# Sensible defaults until there is enough history for a time slot.
TOD_DEFAULT = {
    "night":   {"heavy": 0.55, "rock": 0.8, "alt": 1.15, "rap": 0.95, "electronic": 1.25, "pop": 0.8, "chill": 1.6},
    "morning": {"heavy": 0.6, "rock": 1.05, "alt": 1.25, "rap": 0.85, "electronic": 0.95, "pop": 1.2, "chill": 1.35},
    "day":     {"heavy": 1.1, "rock": 1.15, "alt": 1.0, "rap": 1.1, "electronic": 1.05, "pop": 1.0, "chill": 0.8},
    "evening": {"heavy": 1.05, "rock": 1.05, "alt": 1.0, "rap": 1.2, "electronic": 1.15, "pop": 0.95, "chill": 0.95},
}


def bucket_of(ts):
    h = time.localtime(ts).tm_hour
    for name, a, b in BUCKETS:
        if a <= h < b:
            return name
    return "night"


def norm_genre(g):
    return re.sub(r"[\s\-_]+", "", g.lower())


def mood_of(genres):
    for g in genres:
        g = norm_genre(g)
        for key, mood in GENRE_RULES:
            if key in g:
                return mood
    return "alt"


def is_reggae_genre(genres):
    return any(REGGAE_GENRE.search(norm_genre(g)) for g in genres)


def split_artists(values):
    out = []
    for v in values:
        for part in re.split(r";|\s+feat\.?\s+|\s+ft\.\s+|\s+x\s+", v, flags=re.I):
            p = part.strip().lower()
            if p:
                out.append(p)
    return out


def title_key(title):
    """"Song (Remastered)", "SONG - Live" and "Song" are the same song."""
    t = re.sub(r"\(.*?\)|\[.*?\]", "", title.lower())
    t = re.sub(r"\s[-–—]\s[^-–—]*\b(?:live|remaster\w*|version|mix|edit|demo|acoustic|mono)\b[^-–—]*$", "", t)
    return re.sub(r"[^\w]+", "", t)


def fmt_age(hours):
    if hours is None:
        return "never"
    if hours < 1 / 60:
        return "just now"
    if hours < 1:
        return f"{max(1, round(hours * 60))} min ago"
    if hours < 48:
        return f"{round(hours)} h ago"
    return f"{round(hours / 24)} days ago"


# ── tiny MPD client (no dependencies) ────────────────────────────────────────
class MPDError(Exception):
    pass


def _quote(a):
    a = str(a)
    return '"' + a.replace("\\", "\\\\").replace('"', '\\"') + '"'


class MPD:
    def __init__(self, timeout=10):
        rt = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        path = os.path.join(rt, "mpd", "socket")
        if os.path.exists(path):
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(timeout)
            s.connect(path)
        else:
            s = socket.create_connection(("127.0.0.1", 6600), timeout=timeout)
        self.sock = s
        self.f = s.makefile("rwb")
        hello = self.f.readline()
        if not hello.startswith(b"OK MPD"):
            raise MPDError("not an MPD server")

    def close(self):
        try:
            self.f.write(b"close\n")
            self.f.flush()
        except Exception:
            pass
        try:
            self.sock.close()
        except Exception:
            pass

    def _send(self, line):
        self.f.write(line.encode() + b"\n")
        self.f.flush()

    def _read(self, list_ok=False):
        """Read pairs until OK (or list_OK when list_ok). Raises on ACK."""
        pairs = []
        while True:
            raw = self.f.readline()
            if not raw:
                raise ConnectionError("MPD closed the connection")
            line = raw.decode("utf-8", "replace").rstrip("\n")
            if line == "OK" or (list_ok and line == "list_OK"):
                return pairs
            if line.startswith("ACK"):
                raise MPDError(line)
            k, _, v = line.partition(": ")
            pairs.append((k, v))

    def cmd(self, name, *args):
        self._send(" ".join([name] + [_quote(a) for a in args]))
        return self._read()

    def batch(self, cmds):
        """Run a command list atomically; returns one pair list per command."""
        lines = ["command_list_ok_begin"]
        for c in cmds:
            lines.append(" ".join([c[0]] + [_quote(a) for a in c[1:]]))
        lines.append("command_list_end")
        self.f.write(("\n".join(lines) + "\n").encode())
        self.f.flush()
        out = []
        for _ in cmds:
            out.append(self._read(list_ok=True))
        self._read()  # final OK
        return out

    def dict(self, name, *args):
        d = {}
        for k, v in self.cmd(name, *args):
            d.setdefault(k, v)
        return d

    @staticmethod
    def songs(pairs):
        out, cur = [], None
        for k, v in pairs:
            if k in ("file", "directory", "playlist"):
                cur = {"_kind": k, "file": v} if k == "file" else {"_kind": k}
                out.append(cur)
                continue
            if cur is None:
                continue
            if k in ("Artist", "Genre", "AlbumArtist"):
                cur.setdefault(k, []).append(v)
            else:
                cur.setdefault(k, v)
        return [s for s in out if s.get("_kind") == "file"]

    def idle(self, *subsystems):
        self._send(" ".join(["idle"] + list(subsystems)))
        self.sock.settimeout(None)  # block for as long as nothing happens
        try:
            return [v for k, v in self._read() if k == "changed"]
        finally:
            self.sock.settimeout(10)


# ── history database ─────────────────────────────────────────────────────────
def db_open():
    os.makedirs(DATA_DIR, exist_ok=True)
    db = sqlite3.connect(DB_PATH, timeout=10)
    db.execute("PRAGMA journal_mode=WAL")
    db.executescript("""
        CREATE TABLE IF NOT EXISTS plays(
            id INTEGER PRIMARY KEY,
            file TEXT NOT NULL,
            artist TEXT,
            mood TEXT,
            started REAL NOT NULL,      -- unix time the track began
            listened REAL,              -- seconds actually played (NULL for seeded rows)
            duration REAL,
            outcome TEXT NOT NULL,      -- full | partial | skip | seed | replaced
            smart INTEGER DEFAULT 0     -- 1 if it came from a My Vibe queue
        );
        CREATE INDEX IF NOT EXISTS plays_file ON plays(file);
        CREATE INDEX IF NOT EXISTS plays_started ON plays(started);
        CREATE TABLE IF NOT EXISTS picks(
            file TEXT NOT NULL,
            at REAL NOT NULL,
            vibe TEXT,                  -- the style it was picked for
            weight REAL,
            factors TEXT                -- JSON: factor name → [multiplier, note]
        );
        CREATE INDEX IF NOT EXISTS picks_file ON picks(file);
        CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value TEXT);
    """)
    return db


def seed_from_journal(db, lib_by_file):
    """Import MPD's own 'player: played "…"' journal lines as history (deduplicated)."""
    try:
        out = subprocess.run(
            ["journalctl", "--user", "-u", "mpd", "-o", "short-unix", "--no-pager",
             "-g", "player: played"], capture_output=True, text=True, timeout=30).stdout
    except Exception:
        return 0
    have = {(f, round(t)) for f, t in db.execute("SELECT file, started FROM plays")}
    n = 0
    for line in out.splitlines():
        m = re.match(r'^(\d+(?:\.\d+)?)\s.*player: played "(.*)"\s*$', line)
        if not m:
            continue
        ts, f = float(m.group(1)), m.group(2).replace('\\"', '"')
        if (f, round(ts)) in have or any((f, round(ts) + d) in have for d in range(-3, 4)):
            continue
        s = lib_by_file.get(f)
        db.execute("INSERT INTO plays(file, artist, mood, started, outcome) VALUES(?,?,?,?, 'seed')",
                   (f, s["primary"] if s else f.split("/")[0], s["mood"] if s else None, ts))
        have.add((f, round(ts)))
        n += 1
    db.execute("INSERT OR REPLACE INTO meta VALUES('seeded', ?)", (str(time.time()),))
    db.commit()
    return n


# ── library ──────────────────────────────────────────────────────────────────
def load_library(mpd):
    songs = MPD.songs(mpd.cmd("listallinfo"))
    lib = []
    for s in songs:
        f = s["file"]
        if f.startswith(".") or "/." in f:
            continue
        primary = f.split("/")[0] if "/" in f else (s.get("AlbumArtist") or s.get("Artist") or ["?"])[0]
        keys = {primary.lower()} | set(split_artists(s.get("Artist", []) + s.get("AlbumArtist", [])))
        try:
            dur = float(s.get("duration") or s.get("Time") or 0)
        except ValueError:
            dur = 0.0
        lib.append({
            "file": f,
            "title": s.get("Title") or os.path.splitext(os.path.basename(f))[0],
            "artist": "; ".join(s.get("Artist", [])) or primary,
            "primary": primary,
            "keys": keys,
            "album": s.get("Album", ""),
            "genres": s.get("Genre", []),
            "mood": mood_of(s.get("Genre", [])),
            "duration": dur,
        })
    return lib


def sticker_files(mpd, name):
    """{file: value} for one song sticker name."""
    out = {}
    try:
        pairs = mpd.cmd("sticker", "find", "song", "", name)
    except MPDError:
        return out
    cur = None
    for k, v in pairs:
        if k == "file":
            cur = v
        elif k == "sticker" and cur is not None:
            key, _, val = v.partition("=")
            if key == name:
                out[cur] = val
    return out


def migrate_love(mpd):
    """Old clients stored likes as sticker "love": turn them into favourites (set first, then drop)."""
    n = 0
    for f, val in sticker_files(mpd, OLD_LOVE).items():
        try:
            if val not in ("0", ""):
                mpd.cmd("sticker", "set", "song", f, FAV, "1")
                n += 1
            mpd.cmd("sticker", "delete", "song", f, OLD_LOVE)
        except MPDError:
            pass
    return n


def load_stickers(mpd):
    st = {"fav": set(), "ban": set(), "rating": {}}
    for name in (FAV, OLD_LOVE):          # a not-yet-migrated "love" still counts
        st["fav"] |= {f for f, v in sticker_files(mpd, name).items() if v not in ("0", "")}
    st["ban"] = {f for f, v in sticker_files(mpd, BAN).items() if v not in ("0", "")}
    for f, v in sticker_files(mpd, "rating").items():
        try:
            st["rating"][f] = float(v)
        except ValueError:
            pass
    st["love"] = st["fav"]                # old name, kept for older readers of this module
    return st


# ── styles: which songs a style may draw from ────────────────────────────────
_user_cache = {"mtime": None, "data": {}}


def user_styles():
    """~/.config/glass-music/styles.json (optional, local, never part of any repo)."""
    try:
        mt = os.stat(USER_STYLES).st_mtime
    except OSError:
        _user_cache.update(mtime=None, data={})
        return {}
    if mt != _user_cache["mtime"]:
        try:
            with open(USER_STYLES, encoding="utf-8") as fh:
                d = json.load(fh)
            _user_cache.update(mtime=mt, data=d if isinstance(d, dict) else {})
        except (OSError, ValueError) as ex:
            print(f"music-smart: ignoring {USER_STYLES}: {ex}", file=sys.stderr, flush=True)
            _user_cache.update(mtime=mt, data={})
    return _user_cache["data"]


def style_defs():
    """Ordered list of {id, label, desc, icon}: the built-ins plus extra styles from styles.json."""
    out = [{"id": i, "label": l, "desc": d, "icon": ic} for i, l, d, ic in BUILTIN_STYLES]
    known = {s["id"] for s in out}
    for sid, cfg in user_styles().items():
        if not isinstance(cfg, dict):
            continue
        if sid in known:
            for s in out:
                if s["id"] == sid:
                    s.update({k: str(cfg[k]) for k in ("label", "desc", "icon") if cfg.get(k)})
            continue
        if not re.match(r"^[a-z0-9][a-z0-9_-]{0,31}$", sid):
            continue
        out.append({"id": sid, "label": str(cfg.get("label") or sid.title()),
                    "desc": str(cfg.get("desc") or "Your own style"), "icon": str(cfg.get("icon") or "custom")})
    return out


def style_ids():
    return [s["id"] for s in style_defs()]


def _cfg_list(cfg, key):
    v = cfg.get(key) or []
    return [str(x) for x in (v if isinstance(v, list) else [v])]


def apply_overrides(pool, lib, cfg, note="your styles.json"):
    """Add / remove songs by genre, artist or path prefix (styles.json)."""
    if not cfg:
        return pool
    genres = [norm_genre(g) for g in _cfg_list(cfg, "genres")]
    artists = {a.lower() for a in _cfg_list(cfg, "artists")}
    files = [p.strip("/") for p in _cfg_list(cfg, "files")]
    x_genres = [norm_genre(g) for g in _cfg_list(cfg, "exclude_genres")]
    x_artists = {a.lower() for a in _cfg_list(cfg, "exclude_artists")}
    x_files = [p.strip("/") for p in _cfg_list(cfg, "exclude_files")]

    def hit(s, gs, ars, fs):
        return ((gs and any(any(g in norm_genre(x) for g in gs) for x in s["genres"]))
                or (ars and s["keys"] & ars)
                or (fs and any(s["file"] == p or s["file"].startswith(p + "/") for p in fs)))

    for s in lib:
        if hit(s, genres, artists, files):
            pool[s["file"]] = (1.0, note)
    for s in lib:
        if s["file"] in pool and hit(s, x_genres, x_artists, x_files):
            del pool[s["file"]]
    return pool


def reggae_pool(lib):
    """file → (strength, reason). Genre tags first; then artists whose songs are mostly tagged
    reggae (their untagged songs, and songs they feature on); then generic title/album words."""
    pool = {}
    tagged = {s["file"] for s in lib if is_reggae_genre(s["genres"])}
    for f in tagged:
        pool[f] = (1.0, "reggae genre tag")
    count, hits = {}, {}
    for s in lib:
        for k in s["keys"]:
            count[k] = count.get(k, 0) + 1
            if s["file"] in tagged:
                hits[k] = hits.get(k, 0) + 1
    reggae_artists = {k for k, n in hits.items() if n / count[k] >= 0.5}
    for s in lib:
        if s["file"] in pool:
            continue
        if s["primary"].lower() in reggae_artists:
            pool[s["file"]] = (0.85, f"{s['primary']} plays reggae")
        elif s["keys"] & reggae_artists:
            pool[s["file"]] = (0.6, "reggae artist featured")
        elif REGGAE_WORDS.search(s["title"]) or REGGAE_WORDS.search(s["album"]):
            pool[s["file"]] = (0.7, "reggae in the title")
    return pool


def style_pool(style, lib, stickers):
    """None = the whole library (My Vibe, Discover); else file → (strength, reason)."""
    cfg = user_styles().get(style)
    cfg = cfg if isinstance(cfg, dict) else {}
    if style in WHOLE_LIBRARY:
        if not cfg:
            return None
        # overrides on a whole-library style only remove songs
        pool = {s["file"]: (1.0, "") for s in lib}
        return apply_overrides(pool, lib, {k: v for k, v in cfg.items() if k.startswith("exclude_")})
    if style == "favourites":
        pool = {s["file"]: (1.0, "a favourite") for s in lib if s["file"] in stickers["fav"]}
    elif style == "reggae":
        pool = reggae_pool(lib)
    elif style in MOODS:
        pool = {s["file"]: (1.0, "") for s in lib if s["mood"] == style}
    else:
        pool = {}
    return apply_overrides(pool, lib, cfg)


# ── the model ────────────────────────────────────────────────────────────────
class Model:
    """Everything learned from history, recomputed cheaply before each pick batch."""

    HALF_LIFE_DAYS = 60.0
    HOT_HALF_LIFE_DAYS = 7.0

    def __init__(self, db, lib, stickers, now=None):
        self.now = now or time.time()
        self.lib = lib
        self.stickers = stickers
        if "fav" not in stickers:        # older callers pass {"love", "ban", "rating"}
            stickers["fav"] = set(stickers.get("love", ()))
        self.bucket = bucket_of(self.now)
        self.track = {}       # file → dict(full, partial, skip, last, n)
        self.artist = {}      # primary → dict(full, skip, last, n, hot)
        tod_counts = {b: {m: 0.0 for m in MOODS} for b, _, _ in BUCKETS}
        mood_of_file = {s["file"]: s["mood"] for s in lib}
        primary_of = {s["file"]: s["primary"] for s in lib}
        self.total_plays = 0
        for f, artist, mood, started, outcome in db.execute(
                "SELECT file, artist, mood, started, outcome FROM plays WHERE outcome != 'replaced'"):
            age_days = max(0.0, (self.now - started) / 86400)
            decay = 0.5 ** (age_days / self.HALF_LIFE_DAYS)
            hot = 0.5 ** (age_days / self.HOT_HALF_LIFE_DAYS)
            t = self.track.setdefault(f, {"full": 0.0, "partial": 0.0, "skip": 0.0, "last": 0.0, "n": 0})
            a = self.artist.setdefault(primary_of.get(f, artist or "?"),
                                       {"full": 0.0, "skip": 0.0, "last": 0.0, "n": 0, "hot": 0.0})
            t["last"] = max(t["last"], started)
            a["last"] = max(a["last"], started)
            if outcome in ("full", "seed"):
                t["full"] += decay
                a["full"] += decay
                a["hot"] += hot
                t["n"] += 1
                a["n"] += 1
            elif outcome == "partial":
                t["partial"] += decay
                a["full"] += 0.5 * decay
                a["hot"] += 0.5 * hot
                t["n"] += 1
                a["n"] += 1
            elif outcome == "skip":
                t["skip"] += decay
                a["skip"] += decay
            if outcome != "skip":
                self.total_plays += 1
                m = mood_of_file.get(f, mood)
                if m in MOODS:
                    tod_counts[bucket_of(started)][m] += decay
        # mood share of the library (what a plain shuffle would give)
        lib_share = {m: 1e-3 for m in MOODS}
        for s in lib:
            lib_share[s["mood"]] += 1
        tot = sum(lib_share.values())
        self.lib_share = {m: v / tot for m, v in lib_share.items()}
        # time-of-day mood preference: defaults blended with what history says
        self.tod = {}
        self.tod_n = {}
        for b, _, _ in BUCKETS:
            n = sum(tod_counts[b].values())
            a = n / (n + 40.0)
            prefs = {}
            for m in MOODS:
                learned = ((tod_counts[b][m] + 0.5) / (n + 0.5 * len(MOODS))) / self.lib_share[m]
                learned = min(2.5, max(0.35, learned))
                prefs[m] = math.exp((1 - a) * math.log(TOD_DEFAULT[b][m]) + a * math.log(learned))
            self.tod[b] = prefs
            self.tod_n[b] = n

    # Static part of a track's weight (everything except the queue-position effects).
    def base(self, s, style="default"):
        f = s["file"]
        fac = {}
        if f in self.stickers["ban"]:
            return 0.0, {"ban": [0.0, "never play"]}
        w = 1.0
        if f in self.stickers["fav"] and style not in ("favourites", "discover"):
            fac["fav"] = [3.0 if style == "default" else 2.0, "a favourite"]
        if f in self.stickers["rating"]:
            r = self.stickers["rating"][f]
            fac["rating"] = [0.4 + 1.6 * min(10, max(0, r)) / 10, f"rated {r:g}/10"]
        t = self.track.get(f)
        a = self.artist.get(s["primary"])
        name = s["primary"]
        if style == "default":
            # what you listen to most: play counts and skips, the artists you play, and who is hot lately
            if t:
                aff = (1 + 0.6 * min(t["full"], 10) + 0.2 * t["partial"]) / (1 + 1.0 * t["skip"])
                aff = min(6.0, max(0.1, aff))
                if abs(aff - 1) > 0.03:
                    fac["history"] = [aff, (f"played {t['n']}×" if t["n"] != 1 else "played before")
                                      if aff > 1 else f"skipped {t['skip']:.0f}×"]
            if a:
                aff = (1 + 0.25 * min(a["full"], 20)) / (1 + 0.3 * a["skip"])
                aff = min(4.0, max(0.3, aff))
                if abs(aff - 1) > 0.03:
                    fac["artist"] = [aff, f"you play {name} a lot" if aff > 1 else f"{name} often skipped"]
                if a["hot"] > 0.5:
                    fac["hot"] = [1 + 0.25 * min(a["hot"], 6), f"{name} is on repeat lately"]
        elif style == "discover":
            # the corners of the library you rarely visit
            if t and (t["full"] + t["partial"]) > 0.2:
                n = t["full"] + t["partial"]
                fac["known"] = [1 / (1 + 0.8 * n), f"played {t['n']}× already"]
            elif not t:
                fac["fresh"] = [2.0, "never played here"]
            if t and t["skip"] > 0.2:
                fac["skips"] = [1 / (1 + 0.6 * t["skip"]), f"skipped {t['skip']:.0f}×"]
            if a and a["full"] > 0.2:
                fac["artist"] = [max(0.4, 1 / (1 + 0.12 * min(a["full"], 20))), f"you know {name} well"]
            elif not a:
                fac["new_artist"] = [1.3, f"{name}: new to your history"]
        else:
            # a style pool: history only nudges within it
            if t:
                aff = (1 + 0.3 * min(t["full"], 5) + 0.1 * t["partial"]) / (1 + 1.2 * t["skip"])
                aff = min(3.0, max(0.15, aff))
                if abs(aff - 1) > 0.03:
                    fac["history"] = [aff, f"{t['full']:.0f} full listens" if aff > 1 else f"skipped {t['skip']:.0f}×"]
            else:
                fac["fresh"] = [1.15, "not played here yet"]
            if a:
                aff = (1 + 0.08 * min(a["full"], 10)) / (1 + 0.25 * a["skip"])
                aff = min(2.0, max(0.4, aff))
                if abs(aff - 1) > 0.03:
                    fac["artist"] = [aff, f"you like {name}" if aff > 1 else f"{name} often skipped"]
        # recently played: strong penalty for the track, a softer one for its artist
        if t and t["last"]:
            h = (self.now - t["last"]) / 3600
            rec = 0.02 if h < 3 else max(0.03, min(1.0, (h / 120.0) ** 0.75))
            if rec < 0.98:
                fac["recent"] = [rec, f"played {fmt_age(h)}"]
            else:
                fac["rested"] = [1.0, f"last played {fmt_age(h)}"]
        if a and a["last"]:
            ha = (self.now - a["last"]) / 3600
            if ha < 2:
                fac["artist_recent"] = [0.6 if style == "default" else 0.35, f"{name} played {fmt_age(ha)}"]
            elif ha < 12 and style != "default":
                fac["artist_recent"] = [0.7, f"{name} played {fmt_age(ha)}"]
        d = s["duration"]
        if 0 < d < 70:
            fac["short"] = [0.25, "very short (intro/skit)"]
        elif d > 900:
            fac["long"] = [0.5, "very long"]
        if style in ("default", "discover", "favourites"):
            tw = self.tod[self.bucket][s["mood"]] ** 0.6
            fac["time"] = [tw, f"{MOOD_LABEL[s['mood']].lower()} fits your {self.bucket}" if tw >= 1
                           else f"{MOOD_LABEL[s['mood']].lower()} is rare for your {self.bucket}"]
        for k, (m, _) in fac.items():
            w *= m
        return w, fac

    # My Vibe draws each pick from one of three tiers, so what you play most dominates even while
    # the history is short: your top (songs / artists you play, favourites), your staples (artists
    # with many songs in the library: you liked them a lot), and wildcards (everything else).
    TIER_SHARE = (("top", 0.55), ("staple", 0.25), ("wild", 0.20))
    STAPLE_SONGS = 5

    def tier(self, s):
        f = s["file"]
        t = self.track.get(f)
        a = self.artist.get(s["primary"])
        if f in self.stickers["fav"] or (t and t["full"] + t["partial"] > 0.2) or (a and a["full"] > 0.3):
            return "top"
        if self.artist_songs.get(s["primary"], 0) >= self.STAPLE_SONGS:
            return "staple"
        return "wild"

    def pick(self, count, style="default", exclude=(), recent_keys=(), start_index=0, pool=None):
        """Weighted random picks without replacement, honouring the artist window.

        pool: None (whole library) or file → (strength, reason). My Vibe opens on your top songs,
        then mixes tiers (see TIER_SHARE); wildcards use flattened weights."""
        exclude = set(exclude)
        if pool is None and style not in WHOLE_LIBRARY:
            pool = style_pool(style, self.lib, self.stickers)
        if not hasattr(self, "artist_songs"):
            self.artist_songs = {}
            for s in self.lib:
                self.artist_songs[s["primary"]] = self.artist_songs.get(s["primary"], 0) + 1
        cands = []
        for s in self.lib:
            if s["file"] in exclude:
                continue
            strength = None
            if pool is not None:
                if s["file"] not in pool:
                    continue
                strength = pool[s["file"]]
            w, fac = self.base(s, style)
            if strength is not None and strength[0] < 0.999:
                w *= strength[0]
                fac = dict(fac, style=[strength[0], strength[1]])
            elif strength is not None and strength[1] and style not in MOODS and style != "favourites":
                fac = dict(fac, style=[1.0, strength[1]])
            if w > 0:
                cands.append((s, w, fac, self.tier(s) if style == "default" else ""))
        # one artist may fill at most ~10 % of a batch when the pool is big enough for that
        cap = max(3, round(0.1 * count)) if len(cands) >= 3 * count else None
        per_artist = {}
        window = [set(k) for k in recent_keys][-ARTIST_WINDOW:]
        titles = []           # the same song in another version (live, remaster…) keeps its distance
        title_rule = True
        out = []
        prev_mood = None
        guard = 0
        while len(out) < count and guard < count * 4:
            guard += 1
            idx = start_index + len(out)
            tiers = [""]
            power = 0.8 if style == "discover" else 1.0
            if style == "default":
                if idx < 3:
                    want = "top"
                else:
                    r, want = random.random(), "wild"
                    for name, share in self.TIER_SHARE:
                        if r < share:
                            want = name
                            break
                        r -= share
                tiers = {"top": ["top", "staple", "wild"], "staple": ["staple", "top", "wild"],
                         "wild": ["wild", "staple", "top"]}[want]
            chosen = None
            for tier in tiers:
                pool_j, weights = [], []
                pw = (1.3 if idx < 3 else 1.0) if tier == "top" else (0.5 if tier == "wild" else power)
                for j, (s, w, fac, tr) in enumerate(cands):
                    if s is None or tr != tier:
                        continue
                    if any(s["keys"] & k for k in window):
                        continue
                    if title_rule and title_key(s["title"]) in titles:
                        continue
                    if cap and per_artist.get(s["primary"], 0) >= cap:
                        continue
                    m = 1.3 if (prev_mood and s["mood"] == prev_mood and style in WHOLE_LIBRARY) else 1.0
                    pool_j.append(j)
                    weights.append((w ** pw) * m)
                if pool_j:
                    chosen = (pool_j, weights, tier)
                    break
            if not chosen:
                if title_rule:
                    title_rule = False
                    continue
                if window:
                    window = window[1:]   # small pool: relax the artist rule
                    continue
                if cap:
                    cap = None
                    continue
                break
            pool_j, weights, tier = chosen
            j = random.choices(pool_j, weights)[0]
            s, w, fac, _ = cands[j]
            cands[j] = (None, 0, None, None)
            fac = dict(fac)
            if tier == "staple":
                fac["staple"] = [1.0, f"you saved {self.artist_songs.get(s['primary'], 0)} {s['primary']} songs"]
            elif tier == "wild":
                fac["chance"] = [1.0, "a wildcard pick"]
            out.append((s, w, fac))
            per_artist[s["primary"]] = per_artist.get(s["primary"], 0) + 1
            window = (window + [s["keys"]])[-ARTIST_WINDOW:]
            titles = (titles + [title_key(s["title"])])[-12:]
            prev_mood = s["mood"]
        return out


def short_why(fac):
    """Two most telling reasons, for the bar / panel."""
    if not fac:
        return ""
    order = []
    for k, (m, note) in fac.items():
        if k in ("rested", "chance", "staple"):
            strength = 0.6
        elif k == "fresh":
            strength = 0.5
        elif k == "style":
            strength = 0.45
        else:
            strength = abs(math.log(max(m, 1e-3)))
        if k in ("recent", "artist_recent", "short", "long", "known", "skips") or m < 1:
            strength *= 0.4   # lead with the reasons it was chosen, not the penalties
        order.append((strength, note))
    order.sort(reverse=True)
    pos = [note for k, (m, note) in fac.items() if m >= 1]
    picked = [n for _, n in order if n in pos][:2]
    if not picked:        # only penalties (small style pools): say why it fits the style instead
        picked = [fac["style"][1]] if fac.get("style") and fac["style"][1] else [n for _, n in order][:1]
    return " · ".join(picked)


# ── state files for the UIs ──────────────────────────────────────────────────
def _write_in_place(path, data):
    # Rewritten in place (not rename-over) so inotify watches on the file survive;
    # one small write, readers retry on a torn read.
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a+", encoding="utf-8") as fh:
        fh.seek(0)
        fh.truncate()
        fh.write(data)


def write_state(st):
    st = dict(st)
    st["updated"] = time.time()
    _write_in_place(STATE_PATH, json.dumps(st, ensure_ascii=False))


def read_state():
    try:
        with open(STATE_PATH) as fh:
            return json.load(fh)
    except Exception:
        return {"active": False}


def style_label(sid):
    for s in style_defs():
        if s["id"] == sid:
            return s["label"]
    return MOOD_LABEL.get(sid, sid)


# ── engine: build / top up the queue ─────────────────────────────────────────
class Engine:
    def __init__(self, mpd, db):
        self.mpd = mpd
        self.db = db
        self.lib = []
        self.by_file = {}
        self.stickers = {"fav": set(), "ban": set(), "rating": {}}
        self.state = read_state()
        self.ids = set(int(i) for i in self.state.get("ids", []))
        self.why = {}   # file → (short why, factors)
        self.styles_sig = None
        self.summary = None        # cached styles summary (library / stickers / styles.json unchanged)
        self.summary_key = None

    def refresh_library(self):
        self.lib = load_library(self.mpd)
        self.by_file = {s["file"]: s for s in self.lib}
        self.summary = None

    def refresh_stickers(self):
        self.stickers = load_stickers(self.mpd)
        self.summary = None

    def model(self):
        return Model(self.db, self.lib, self.stickers)

    def style(self):
        sid = self.state.get("style") or "default"
        return sid if sid in style_ids() else "default"

    def styles_summary(self):
        """[{id, label, desc, icon, n}] (+ writes styles.json with the song lists when they change)."""
        key = _user_cache["mtime"] if user_styles() is not None else None
        if self.summary is not None and key == self.summary_key:
            return self.summary
        self.summary_key = key
        out, pools = [], {}
        playable = [s for s in self.lib if s["file"] not in self.stickers["ban"]]
        for d in style_defs():
            pool = style_pool(d["id"], self.lib, self.stickers)
            if pool is None:
                n = len(playable)
            else:
                files = sorted((f for f in pool if f not in self.stickers["ban"]),
                               key=lambda f: -pool[f][0])
                n = len(files)
                pools[d["id"]] = files
            out.append(dict(d, n=n))
        sig = json.dumps([out, pools], ensure_ascii=False, sort_keys=True)
        if sig != self.styles_sig:
            self.styles_sig = sig
            try:
                _write_in_place(POOLS_PATH, json.dumps({"styles": out, "pools": pools, "updated": time.time()},
                                                       ensure_ascii=False))
            except OSError:
                pass
        self.summary = out
        return out

    def publish(self, **extra):
        """Write state.json: My Vibe state + the current track's favourite flag + the style list."""
        new = dict(self.state)
        new.update(extra)
        sid = new.get("style") if new.get("style") in style_ids() else "default"
        new["style"] = sid
        new["styleLabel"] = style_label(sid)
        new["vibe"], new["vibeLabel"] = sid, new["styleLabel"]      # old names (older UIs)
        new["styles"] = self.styles_summary() if self.lib else new.get("styles", [])
        try:
            cur = self.mpd.dict("currentsong").get("file", "")
        except (MPDError, ConnectionError, OSError):
            cur = new.get("cur", "")
        new["cur"] = cur
        new["fav"] = bool(cur) and cur in self.stickers["fav"]
        new["banned"] = bool(cur) and cur in self.stickers["ban"]
        if {k: v for k, v in new.items() if k != "updated"} != {k: v for k, v in self.state.items() if k != "updated"}:
            self.state = new
            write_state(new)

    def _record_picks(self, picks, style):
        now = time.time()
        rows = []
        for s, w, fac in picks:
            self.why[s["file"]] = (short_why(fac), fac)
            rows.append((s["file"], now, style, w, json.dumps(fac, ensure_ascii=False)))
        self.db.executemany("INSERT INTO picks VALUES(?,?,?,?,?)", rows)
        self.db.execute("DELETE FROM picks WHERE rowid NOT IN (SELECT rowid FROM picks ORDER BY at DESC LIMIT 3000)")
        self.db.commit()

    def start(self, style=None, reroll=False):
        """Replace the queue with a fresh queue in `style` and play it. Returns (style, picks) or
        (style, None, message) when the style has nothing to play."""
        if not self.lib:
            self.refresh_library()
        if style not in style_ids():
            style = self.style()
        m = self.model()
        pool = style_pool(style, self.lib, self.stickers)
        if pool is not None:
            pool = {f: v for f, v in pool.items() if f not in self.stickers["ban"]}
            if not pool:
                msg = ("No favourites yet: star songs in Glass Music (or `music-smart fav`)" if style == "favourites"
                       else f"No songs match {style_label(style)} yet")
                self.publish(notice=msg, noticeAt=time.time())
                return style, None, msg
        cur = self.mpd.dict("currentsong")
        exclude = {cur["file"]} if cur.get("file") else set()
        size = QUEUE_SIZE if pool is None else min(QUEUE_SIZE, len(pool))
        if reroll:
            # a re-roll should feel new: skip what the old queue still had coming, if there is room
            queue = [s["file"] for s in MPD.songs(self.mpd.cmd("playlistinfo"))]
            avail = len(self.lib) if pool is None else len(pool)
            if avail - len(exclude | set(queue)) >= size:
                exclude |= set(queue)
        recent = [r[0] for r in self.db.execute("SELECT file FROM plays ORDER BY started DESC LIMIT 3")]
        recent_keys = [self.by_file[f]["keys"] for f in reversed(recent) if f in self.by_file]
        picks = m.pick(size, style, exclude, recent_keys, pool=pool)
        if not picks and exclude:
            picks = m.pick(size, style, set(), recent_keys, pool=pool)
        if not picks:
            return style, None, f"Nothing to play in {style_label(style)}"
        self._record_picks(picks, style)
        cmds = [("clear",), ("random", "0"), ("single", "0"), ("consume", "0"), ("repeat", "0")]
        cmds += [("addid", s["file"]) for s, _, _ in picks]
        cmds += [("play", "0")]
        res = self.mpd.batch(cmds)
        ids = []
        for r in res[5:5 + len(picks)]:
            for k, v in r:
                if k == "Id":
                    ids.append(int(v))
        self.ids = set(ids)
        first = picks[0]
        self.state = {"active": True, "style": style, "bucket": m.bucket, "started": time.time(),
                      "ids": sorted(self.ids), "file": first[0]["file"], "why": short_why(first[2]),
                      "queued": len(picks) - 1, "picks": len(picks), "pool": size if pool is not None else None,
                      "styles": self.state.get("styles", [])}
        self.publish()
        return style, picks

    def stop(self, reason="stopped"):
        if self.state.get("active"):
            self.ids = set()
            self.state = {"active": False, "style": self.style(), "reason": reason,
                          "styles": self.state.get("styles", [])}
            self.publish()

    def check(self):
        """After a player/playlist change: stay in My Vibe, top up, trim, update the UI."""
        if not self.state.get("active"):
            self.publish()
            return
        st = self.mpd.dict("status")
        queue = MPD.songs(self.mpd.cmd("playlistinfo"))
        qids = [int(s.get("Id", -1)) for s in queue]
        mine = self.ids & set(qids)
        cur_id = int(st["songid"]) if "songid" in st else None
        if not mine:
            return self.stop("queue replaced")
        if cur_id is not None and cur_id not in self.ids:
            return self.stop("another track was started")
        if st.get("random") == "1":
            return self.stop("random was switched on")
        pos = int(st.get("song", -1)) if "song" in st else -1
        changed = False
        style = self.style()
        # top up as the queue drains
        if cur_id is not None and len(queue) - pos - 1 < TOPUP_BELOW:
            if not self.lib:
                self.refresh_library()
            m = self.model()
            pool = style_pool(style, self.lib, self.stickers)
            upcoming = {s["file"] for s in queue[max(0, pos):]}
            # big pools: nothing that is still in the queue; small pools (e.g. reggae): only skip
            # what is coming up, the long-ago played part may come round again
            avail = len(self.lib) if pool is None else len(pool)
            exclude = {s["file"] for s in queue} if avail > 3 * (len(queue) + TOPUP_COUNT) else upcoming
            tail = [self.by_file[s["file"]]["keys"] for s in queue[-ARTIST_WINDOW:] if s["file"] in self.by_file]
            picks = m.pick(TOPUP_COUNT, style, exclude, tail,
                           start_index=self.state.get("picks", QUEUE_SIZE), pool=pool)
            if picks:
                self._record_picks(picks, style)
                res = self.mpd.batch([("addid", s["file"]) for s, _, _ in picks])
                for r in res:
                    for k, v in r:
                        if k == "Id":
                            self.ids.add(int(v))
                self.state["picks"] = self.state.get("picks", 0) + len(picks)
                changed = True
        # keep the played part of the queue short
        if pos > KEEP_PLAYED:
            self.mpd.cmd("delete", f"0:{pos - KEEP_PLAYED}")
            changed = True
        if changed:
            st = self.mpd.dict("status")
            queue = MPD.songs(self.mpd.cmd("playlistinfo"))
            qids = [int(s.get("Id", -1)) for s in queue]
            pos = int(st.get("song", -1)) if "song" in st else -1
        self.ids &= set(qids)
        cur_file = queue[pos]["file"] if 0 <= pos < len(queue) else ""
        why = self.why.get(cur_file)
        if why is None and cur_file:
            why = lookup_pick(self.db, cur_file)
        self.state["ids"] = sorted(self.ids)
        self.publish(file=cur_file, why=why[0] if why else "", queued=max(0, len(queue) - pos - 1))


def lookup_pick(db, f):
    row = db.execute("SELECT factors FROM picks WHERE file=? ORDER BY at DESC LIMIT 1", (f,)).fetchone()
    if not row:
        return None
    fac = json.loads(row[0])
    return short_why(fac), fac


# ── play logger ──────────────────────────────────────────────────────────────
class Tracker:
    """Turns MPD player events into play rows: listened time is wall-clock time in 'play'."""

    def __init__(self, engine):
        self.e = engine
        self.cur = None
        self.replacing = False

    def _finish(self, now):
        c = self.cur
        if not c:
            return
        self.cur = None
        listened = c["offset"] + c["acc"] + ((now - c["since"]) if c["since"] else 0)
        dur = c["duration"]
        if self.replacing:
            outcome = "replaced"
        elif dur > 0 and (listened >= 0.75 * dur or dur - listened < 25):
            outcome = "full"
        elif dur > 0 and listened < 0.4 * dur:
            outcome = "skip"
        elif dur <= 0 and listened >= 120:
            outcome = "full"
        else:
            outcome = "partial"
        if listened < 1.5 and outcome == "skip" and c["offset"] == 0 and c["acc"] == 0 and not c["since"]:
            return  # passed over without ever playing (e.g. stepping through a paused queue)
        s = self.e.by_file.get(c["file"])
        self.e.db.execute(
            "INSERT INTO plays(file, artist, mood, started, listened, duration, outcome, smart) VALUES(?,?,?,?,?,?,?,?)",
            (c["file"], s["primary"] if s else c["file"].split("/")[0], s["mood"] if s else None,
             c["started"], round(listened, 1), dur, outcome, 1 if c["smart"] else 0))
        self.e.db.commit()

    def update(self):
        now = time.time()
        st = self.e.mpd.dict("status")
        state = st.get("state", "stop")
        sid = st.get("songid")
        elapsed = float(st.get("elapsed", 0) or 0)
        if state == "stop" or sid is None:
            self._finish(now)
            self.replacing = False
            return
        c = self.cur
        restarted = c and c["id"] == sid and state == "play" and elapsed + 5 < c.get("last_el", 0) and elapsed < 5
        if c is None or c["id"] != sid or restarted:
            self._finish(now)
            self.replacing = False
            song = self.e.mpd.dict("currentsong")
            dur = float(st.get("duration", 0) or song.get("duration", 0) or 0)
            self.cur = {"id": sid, "file": song.get("file", ""), "duration": dur,
                        "started": now - elapsed, "offset": elapsed if elapsed > 3 else 0.0, "acc": 0.0,
                        "since": now if state == "play" else None, "last_el": elapsed,
                        "smart": self.e.state.get("active") and int(sid) in self.e.ids}
            return
        if state == "play" and not c["since"]:
            c["since"] = now
        elif state != "play" and c["since"]:
            c["acc"] += now - c["since"]
            c["since"] = None
        c["last_el"] = elapsed


def daemon():
    # Single instance per state dir: two loggers would double every play row.
    import fcntl
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(os.path.join(STATE_DIR, "daemon.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("music-smart: another daemon is already running", flush=True)
        return
    backoff = 1
    while True:
        mpd = None
        try:
            mpd = MPD()
            db = db_open()
            eng = Engine(mpd, db)
            eng.refresh_library()
            n = migrate_love(mpd)
            if n:
                print(f"music-smart: {n} old 'love' stickers are favourites now", flush=True)
            eng.refresh_stickers()
            if not db.execute("SELECT 1 FROM meta WHERE key='seeded'").fetchone():
                n = seed_from_journal(db, eng.by_file)
                print(f"music-smart: seeded {n} plays from the MPD journal", flush=True)
            mpd.cmd("subscribe", CHANNEL)
            tracker = Tracker(eng)
            tracker.update()
            eng.check()
            print("music-smart: ready (%d tracks)" % len(eng.lib), flush=True)
            backoff = 1
            while True:
                changed = mpd.idle("player", "playlist", "database", "message", "sticker", "options")
                if "database" in changed:
                    eng.refresh_library()
                if "sticker" in changed:
                    if migrate_love(mpd):     # an old client set "love": it becomes a favourite
                        pass
                    eng.refresh_stickers()
                if "message" in changed:
                    for k, v in mpd.cmd("readmessages"):
                        if k != "message":
                            continue
                        verb, _, arg = v.partition(":")
                        if verb in ("start", "reroll"):
                            style = arg or None
                            same = eng.state.get("active") and (style is None or style == eng.style())
                            tracker.replacing = True
                            tracker._finish(time.time())
                            tracker.replacing = False
                            eng.start(style=style, reroll=(verb == "reroll" or same))
                        elif verb == "stop":
                            eng.stop("stopped")
                        elif verb == "refresh":
                            eng.publish()
                    tracker.update()
                if changed and set(changed) & {"player", "playlist", "options"}:
                    tracker.update()
                    eng.check()
                elif changed and set(changed) & {"sticker", "database"}:
                    eng.publish()
        except (ConnectionError, OSError, MPDError, socket.timeout) as ex:
            print(f"music-smart: MPD unavailable ({ex}); retrying in {backoff}s", flush=True)
            try:
                if mpd:
                    mpd.close()
            except Exception:
                pass
            time.sleep(backoff)
            backoff = min(60, backoff * 2)


# ── CLI ──────────────────────────────────────────────────────────────────────
def daemon_listening(mpd):
    try:
        return any(v == CHANNEL for k, v in mpd.cmd("channels"))
    except MPDError:
        return False


def cmd_start(style=None, reroll=False):
    if style is not None and style not in style_ids():
        print(f"music-smart: unknown style '{style}'. Styles: {', '.join(style_ids())}", file=sys.stderr)
        return 2
    mpd = MPD()
    if daemon_listening(mpd):
        before = read_state().get("updated", 0)
        msg = ("reroll" if reroll else "start") + (":" + style if style else "")
        mpd.cmd("sendmessage", CHANNEL, msg)
        mpd.close()
        for _ in range(60):           # wait (≤3 s) so the printed style is the new one
            st = read_state()
            if st.get("updated", 0) > before and (st.get("active") or st.get("noticeAt", 0) > before):
                break
            time.sleep(0.05)
        st = read_state()
        if st.get("noticeAt", 0) > before and st.get("notice"):
            print(st["notice"])
            return 1
        label = "My Vibe" if st.get("style", "default") == "default" else f"My Vibe · {st.get('styleLabel', '?')}"
        print(f"{label}: {int(st.get('queued', 0)) + 1} tracks queued")
        if st.get("why"):
            print(f"  now: {st['why']}")
        return 0
    # No daemon: do it here (no top-up until the service runs again).
    db = db_open()
    eng = Engine(mpd, db)
    eng.refresh_library()
    eng.refresh_stickers()
    if not db.execute("SELECT 1 FROM meta WHERE key='seeded'").fetchone():
        seed_from_journal(db, eng.by_file)
    same = eng.state.get("active") and (style is None or style == eng.style())
    r = eng.start(style=style, reroll=reroll or same)
    mpd.close()
    if r[1] is None:
        print(r[2])
        return 1
    print(f"My Vibe · {style_label(r[0])}: {len(r[1])} tracks queued "
          "(music-smart.service is not running: no automatic top-up)")
    return 0


def cmd_stop():
    mpd = MPD()
    if daemon_listening(mpd):
        mpd.cmd("sendmessage", CHANNEL, "stop")
    else:
        st = read_state()
        if st.get("active"):
            st.update(active=False, reason="stopped")
            write_state(st)
    mpd.close()
    print("My Vibe is off (the queue keeps playing).")


def cmd_styles(as_json):
    mpd = MPD()
    lib = load_library(mpd)
    stick = load_stickers(mpd)
    mpd.close()
    out = []
    playable = [s for s in lib if s["file"] not in stick["ban"]]
    for d in style_defs():
        pool = style_pool(d["id"], lib, stick)
        if pool is None:
            out.append(dict(d, n=len(playable)))
            continue
        pool = {f: v for f, v in pool.items() if f not in stick["ban"]}
        why = {}
        for f, (strength, reason) in pool.items():
            why[reason or "matches"] = why.get(reason or "matches", 0) + 1
        out.append(dict(d, n=len(pool), how=why))
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
        return
    cur = read_state().get("style", "default")
    for d in out:
        how = ""
        if d.get("how") and d["id"] not in MOODS and d["id"] != "favourites":
            how = "  (" + ", ".join(f"{n} {r}" for r, n in sorted(d["how"].items(), key=lambda kv: -kv[1])
                                    if not r.endswith("plays reggae")) + \
                  (f", {sum(n for r, n in d['how'].items() if r.endswith('plays reggae'))} by reggae artists"
                   if any(r.endswith("plays reggae") for r in d["how"]) else "") + ")"
        mark = "→" if d["id"] == cur else " "
        print(f" {mark} {d['id']:<11} {d['label']:<12} {d['n']:>5} songs  {d['desc']}{how}")
    if os.path.exists(USER_STYLES):
        print(f"\nLocal overrides: {USER_STYLES}")


def cmd_why():
    mpd = MPD()
    song = mpd.dict("currentsong")
    db = db_open()
    if not song.get("file"):
        print("Nothing is playing.")
        return
    f = song["file"]
    title = f"{song.get('Artist', '?')} — {song.get('Title', f)}"
    st = read_state()
    row = db.execute("SELECT at, vibe, weight, factors FROM picks WHERE file=? ORDER BY at DESC LIMIT 1", (f,)).fetchone()
    print(title)
    if row and st.get("active") and st.get("file") == f:
        at, style, weight, factors = row
        print(f"Picked by My Vibe {fmt_age((time.time() - at) / 3600)} "
              f"({style_label(style)}), weight {weight:.2f} vs 1.00 for an average track:")
        fac = json.loads(factors)
    else:
        style = st.get("style") or "default"
        print(f"Not from the current My Vibe queue; this is how it would score in {style_label(style)} now:")
        lib = load_library(mpd)
        s = next((x for x in lib if x["file"] == f), None)
        if not s:
            print("  (not in the library)")
            return
        mdl = Model(db, lib, load_stickers(mpd))
        weight, fac = mdl.base(s, style)
        print(f"  weight {weight:.2f}")
    for k, (m, note) in sorted(fac.items(), key=lambda kv: -abs(math.log(max(kv[1][0], 1e-3)))):
        arrow = "▲" if m > 1.02 else ("▼" if m < 0.98 else "·")
        print(f"  {arrow} ×{m:<5.2f} {note}")
    mpd.close()


def cmd_stats():
    mpd = MPD()
    db = db_open()
    lib = load_library(mpd)
    stick = load_stickers(mpd)
    mpd.close()
    mdl = Model(db, lib, stick)
    now = time.time()
    rows = db.execute("SELECT outcome, COUNT(*) FROM plays GROUP BY outcome").fetchall()
    counts = dict(rows)
    total = sum(counts.values())
    week = db.execute("SELECT COUNT(*) FROM plays WHERE started > ? AND outcome != 'replaced'", (now - 7 * 86400,)).fetchone()[0]
    smart = db.execute("SELECT COUNT(*), SUM(outcome='skip') FROM plays WHERE smart=1").fetchone()
    st = read_state()
    print(f"Library: {len(lib)} tracks, {len({s['primary'] for s in lib})} artists "
          f"(all of it counts as liked) · favourites {len(stick['fav'])} · never play {len(stick['ban'])}")
    mix = {m: sum(1 for s in lib if s["mood"] == m) for m in MOODS}
    print("Moods:   " + "  ".join(f"{MOOD_LABEL[m]} {mix[m]}" for m in MOODS))
    print(f"History: {total} rows — " + ", ".join(f"{k} {v}" for k, v in sorted(counts.items())) +
          f"; {week} plays in the last 7 days; {len(mdl.track)} different tracks")
    if smart[0]:
        print(f"My Vibe queues: {smart[0]} tracks played, {smart[1] or 0} skipped "
              f"({100 * (smart[1] or 0) / smart[0]:.0f} %)")
    print(f"My Vibe: {'ON — ' + st.get('styleLabel', '') + ', ' + str(st.get('queued', 0)) + ' tracks left' if st.get('active') else 'off'}"
          f" · style {st.get('styleLabel', 'My Vibe')}")
    print("\nTime of day (mood weight now in use; ✱ = learned from ≥ 10 plays):")
    for b, a, z in BUCKETS:
        mark = "→" if b == mdl.bucket else " "
        n = mdl.tod_n[b]
        best = sorted(MOODS, key=lambda m: -mdl.tod[b][m])
        print(f" {mark} {b:<8} {a:02d}–{z:02d}  {'✱' if n >= 10 else ' '} plays {n:5.1f}  " +
              "  ".join(f"{MOOD_LABEL[m]} {mdl.tod[b][m]:.2f}" for m in best[:4]))
    top = sorted(mdl.artist.items(), key=lambda kv: -kv[1]["full"])[:8]
    if top:
        print("\nMost listened artists: " + ", ".join(f"{a} ({v['full']:.1f})" for a, v in top if v["full"] > 0.05))
    skipped = sorted(((v["skip"], f) for f, v in mdl.track.items() if v["skip"] >= 1), reverse=True)[:5]
    if skipped:
        print("Most skipped: " + ", ".join(f"{f.split('/')[-1].rsplit('.', 1)[0]} ({n:.0f})" for n, f in skipped))
    last = db.execute("SELECT file, started, outcome, listened FROM plays ORDER BY started DESC LIMIT 6").fetchall()
    if last:
        print("\nRecent plays:")
        for f, t, o, li in last:
            print(f"  {time.strftime('%a %H:%M', time.localtime(t))}  {o:<8} "
                  f"{'' if li is None else str(round(li)) + ' s':>6}  {f}")


def cmd_sticker(name, value, target):
    mpd = MPD()
    f = target or mpd.dict("currentsong").get("file")
    if not f:
        print("Nothing is playing; give a file path relative to the music directory.")
        return 1
    if value is None:
        try:
            mpd.cmd("sticker", "delete", "song", f, name)
        except MPDError:
            pass
    else:
        mpd.cmd("sticker", "set", "song", f, name, value)
    mpd.close()
    print(f"{'un' if value is None else ''}{name}: {f}")
    return 0


def cmd_fav(mode, target):
    """fav on|off|toggle [FILE] — favourites are the sticker "favourite" (old "love" migrates)."""
    mpd = MPD()
    migrate_love(mpd)
    f = target or mpd.dict("currentsong").get("file")
    if not f:
        mpd.close()
        print("Nothing is playing; give a file path relative to the music directory.")
        return 1
    on = f in sticker_files(mpd, FAV)
    want = (not on) if mode == "toggle" else (mode == "on")
    if want:
        mpd.cmd("sticker", "set", "song", f, FAV, "1")
    elif on:
        mpd.cmd("sticker", "delete", "song", f, FAV)
    mpd.close()
    print(("★ favourite: " if want else "☆ not a favourite: ") + f)
    return 0


def cmd_status(as_json):
    st = read_state()
    if as_json:
        print(json.dumps({k: v for k, v in st.items() if k not in ("ids", "styles")}, ensure_ascii=False))
    elif st.get("active"):
        print(f"on · {st.get('styleLabel')} · {st.get('queued', 0)} tracks left · {st.get('why', '')}")
    else:
        print(f"off · style {st.get('styleLabel', 'My Vibe')}")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "start"
    arg = argv[2] if len(argv) > 2 else None
    try:
        if cmd in ("start", "toggle", "go", "play"):
            return cmd_start(style=arg, reroll=False)
        elif cmd in ("reroll", "re-roll", "next"):
            return cmd_start(style=arg, reroll=True)
        elif cmd in ("stop", "off"):
            cmd_stop()
        elif cmd == "styles":
            cmd_styles("--json" in argv)
        elif cmd in ("why", "explain-why", "explain"):
            cmd_why()
        elif cmd == "stats":
            cmd_stats()
        elif cmd in ("fav", "favourite", "favorite"):
            mode = arg if arg in ("on", "off", "toggle") else "toggle"
            target = argv[3] if (arg in ("on", "off", "toggle") and len(argv) > 3) else \
                (arg if arg not in ("on", "off", "toggle") else None)
            return cmd_fav(mode, target)
        elif cmd in ("love", "unlove"):              # old names
            return cmd_fav("on" if cmd == "love" else "off", arg)
        elif cmd == "ban":
            return cmd_sticker(BAN, "1", arg)
        elif cmd == "unban":
            return cmd_sticker(BAN, None, arg)
        elif cmd == "status":
            cmd_status("--json" in argv)
        elif cmd == "seed":
            mpd = MPD()
            db = db_open()
            n = seed_from_journal(db, {s["file"]: s for s in load_library(mpd)})
            mpd.close()
            print(f"Imported {n} plays from the MPD journal.")
        elif cmd == "daemon":
            daemon()
        elif cmd in ("-h", "--help", "help"):
            print(__doc__.strip())
        elif cmd in style_ids():                   # `music-smart reggae` = `music-smart start reggae`
            return cmd_start(style=cmd, reroll=False)
        else:
            print(__doc__.strip())
            return 2
    except (ConnectionError, OSError) as ex:
        print(f"music-smart: cannot reach MPD ({ex})", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
