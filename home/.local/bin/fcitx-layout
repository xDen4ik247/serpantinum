#!/usr/bin/env bash
# Bridge between fcitx5 and Serpantinum's keyboard pill (see ~/.config/serp-tweaks/patches).
#
#   fcitx-layout get     print EN / RU / JP for the active input method (fails if fcitx5 isn't running)
#   fcitx-layout next    toggle EN <-> RU like Alt+Shift (three quick ones = JP, see fcitx-jp-gate)
#   fcitx-layout watch   wait until the input method changes, then print one line
set -u

case "${1:-}" in
    get)
        im=$(fcitx5-remote -n 2>/dev/null) && [ -n "$im" ] || exit 1
        case "$im" in
            mozc|anthy|kkc|skk) echo JP ;;
            keyboard-us*)       echo EN ;;
            keyboard-*)         im=${im#keyboard-}; echo "${im:0:2}" | tr '[:lower:]' '[:upper:]' ;;
            *)                  echo "${im:0:2}" | tr '[:lower:]' '[:upper:]' ;;
        esac
        ;;
    next)
        # same as Alt+Shift: EN <-> RU, and fcitx-jp-gate turns the third quick switch into Mozc
        fcitx5-remote >/dev/null 2>&1 || exit 1
        exec fcitx5-remote -t
        ;;
    watch)
        # fcitx5 announces every switch by updating its (hidden) tray icon.
        coproc MON { exec dbus-monitor --session "type='signal',interface='org.kde.StatusNotifierItem',member='NewIcon'" 2>/dev/null; }
        trap 'kill "$MON_PID" 2>/dev/null' EXIT
        trap 'exit 0' TERM INT
        while IFS= read -r line <&"${MON[0]}"; do
            [[ $line == *member=NewIcon* ]] && { echo changed; exit 0; }
        done
        ;;
    *)
        sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
