#!/bin/bash
# ai-chat — Mod+A: floating liquid-glass assistant (kitty, app-id "ai-chat").
# If it is already open, focus it instead of starting a second one (~/.local/bin/niri-focus-or-run).
exec "$HOME/.local/bin/niri-focus-or-run" ai-chat -- \
    kitty --class ai-chat --title "Assistant" -o window_padding_width=14 -o remember_window_size=no \
    "$HOME/.venvs/default/bin/python" "$HOME/.local/share/aifeat/chat.py"
