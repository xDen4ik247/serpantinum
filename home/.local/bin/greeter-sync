#!/usr/bin/env bash
# greeter-sync — copy the current Serpantinum wallpaper + Matugen palette to the
# world-readable place the SDDM "serp-glass" theme reads (no root needed after the
# one-time install, which creates the directory owned by this user).
#
#   greeter-sync            sync if wallpaper/palette changed (cheap no-op otherwise)
#   greeter-sync --force    always rebuild
#   GREETER_SYNC_DIR=/path greeter-sync   write somewhere else (testing)
#
# Output: bg.jpg (wallpaper, cover-scaled), bg-blur.jpg (blurred + saturated, the
# glass backdrop), avatar.png (optional) and theme.conf.user (palette as INI; the
# theme dir symlinks theme.conf.user -> here, so SDDM loads it as theme config).
set -euo pipefail

OUT="${GREETER_SYNC_DIR:-/var/lib/serp-greeter}"
W=2880 H=1800                       # panel resolution (X11 greeter renders 1:1)
CACHE="$HOME/.cache/serpantinum/wallpaper"
STATE="$HOME/.local/state/serpantinum"
SETTINGS="$HOME/.config/serpantinum/settings.json"
FORCE=0; [[ "${1:-}" == "--force" ]] && FORCE=1

if [[ ! -d "$OUT" || ! -w "$OUT" ]]; then
    echo "greeter-sync: $OUT missing or not writable (run the serp-glass install script once)" >&2
    exit 0
fi

# ---- wallpaper -------------------------------------------------------------
wp=""
for f in "$CACHE"/current_eDP-1 "$CACHE"/current_*; do
    [[ -f "$f" && "$f" != *_name && "$f" != *.json && "$f" != *.png && "$f" != *session* ]] || continue
    wp="$(head -n1 "$f")"; break
done
case "${wp,,}" in
    *.png|*.jpg|*.jpeg|*.webp|*.bmp|*.gif) ;;
    *) # video / unknown: use the shell's poster snapshot
       wp=""
       for s in "$CACHE"/current_wallpaper_eDP-1.png "$CACHE"/current_wallpaper.png; do
           [[ -f "$s" ]] && { wp="$s"; break; }
       done ;;
esac
[[ -n "$wp" && -f "$wp" ]] || { echo "greeter-sync: no current wallpaper found" >&2; exit 0; }

pal="$STATE/qs_colors.json"; [[ -f "$pal" ]] || pal="$STATE/qs_matugen_colors.json"

avatar=""
cand="$(jq -r '[.. | objects | .avatarPath? // empty | select(. != "")][0] // empty' "$SETTINGS" 2>/dev/null || true)"
for a in "$cand" "$HOME/.face" "$HOME/.face.icon"; do
    [[ -n "$a" && -f "$a" ]] && { avatar="$a"; break; }
done

# ---- skip when nothing changed ----------------------------------------------
key="$(stat -c '%n %s %Y' "$wp" "$pal" ${avatar:+"$avatar"} 2>/dev/null | md5sum | cut -c1-16)"
if [[ $FORCE -eq 0 && -f "$OUT/.stamp" && "$(cat "$OUT/.stamp")" == "$key" && -f "$OUT/bg-blur.jpg" ]]; then
    exit 0
fi

tmp="$(mktemp -d "$OUT/.tmp.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
src="$wp[0]"   # first frame for gifs

# sharp: cover-scale to the panel
magick "$src" -resize "${W}x${H}^" -gravity center -extent "${W}x${H}" \
       -quality 92 "$tmp/bg.jpg"
# blurred: blur at quarter size (fast, silky), boost saturation like niri's
# background-effect, scale back up, add a whisper of grain against banding
magick "$src" -resize "$((W/4))x$((H/4))^" -gravity center -extent "$((W/4))x$((H/4))" \
       -blur 0x9 -modulate 100,140 -resize "${W}x${H}!" \
       -attenuate 0.25 +noise Gaussian -quality 93 "$tmp/bg-blur.jpg"

if [[ -n "$avatar" ]]; then
    magick "$avatar[0]" -resize 512x512^ -gravity center -extent 512x512 "$tmp/avatar.png" \
        || rm -f "$tmp/avatar.png"
fi

# ---- palette -> INI -----------------------------------------------------------
c() { jq -r --arg k "$1" --arg d "$2" '.[$k] // $d' "$pal" 2>/dev/null || echo "$2"; }
{
    echo "# generated by ~/.local/bin/greeter-sync — do not edit"
    echo "[General]"
    echo "background=\"$OUT/bg.jpg\""
    echo "backgroundBlur=\"$OUT/bg-blur.jpg\""
    if [[ -f "$tmp/avatar.png" ]]; then echo "avatar=\"$OUT/avatar.png\""; else echo "avatar=\"\""; fi
    echo "base=\"$(c base '#0e1415')\""
    echo "mantle=\"$(c mantle '#161d1d')\""
    echo "surface=\"$(c surface1 '#252b2c')\""
    echo "text=\"$(c text '#dde4e4')\""
    echo "subtext=\"$(c subtext0 '#bec8c9')\""
    echo "muted=\"$(c subtext1 '#899393')\""
    echo "accent=\"$(c blue '#80d4db')\""
    echo "accent2=\"$(c peach '#b7c7ea')\""
    echo "accentInk=\"$(c sapphire '#004f54')\""
    echo "error=\"$(c red '#ffb4ab')\""
    echo "stamp=\"$(date +%s)\""
} > "$tmp/theme.conf.user"

chmod 644 "$tmp"/*
for f in bg.jpg bg-blur.jpg theme.conf.user; do mv -f "$tmp/$f" "$OUT/$f"; done
if [[ -f "$tmp/avatar.png" ]]; then mv -f "$tmp/avatar.png" "$OUT/avatar.png"; else rm -f "$OUT/avatar.png"; fi
echo "$key" > "$OUT/.stamp"
echo "greeter-sync: updated $OUT from $wp"
