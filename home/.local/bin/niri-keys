#!/usr/bin/python3
"""niri-keys: list every niri keybinding that ~/.config/niri/config.kdl actually loads.

Follows `include` lines (recursively, in order), reads every `binds {}` block, gives each
bind a readable label (hotkey-overlay-title, else one derived from the action) and a group.

  niri-keys              grouped table
  niri-keys --json       JSON for the Serpantinum cheat sheet (cheatsheet/Cheatsheet.qml)
  niri-keys --raw        don't fold Mod+1..9 style runs into one row
  niri-keys --check      report duplicate keys across files (exit 1 if any)
  niri-keys --config F   read another root config
"""
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
DEFAULT_CONFIG = os.path.join(HOME, ".config/niri/config.kdl")

# ── tiny KDL reader (enough for niri configs) ────────────────────────────────

class Bare(str):
    """A bare (unquoted) KDL value such as null, true, 150."""


def tokenize(src):
    i, n = 0, len(src)
    toks = []
    while i < n:
        c = src[i]
        if c == "\n" or c == ";":
            toks.append(("end", c)); i += 1
        elif c in " \t\r﻿":
            i += 1
        elif c == "\\":                       # line continuation
            j = src.find("\n", i)
            i = n if j < 0 else j + 1
        elif src.startswith("//", i):
            j = src.find("\n", i)
            i = n if j < 0 else j
        elif src.startswith("/*", i):
            depth, i = 1, i + 2
            while i < n and depth:
                if src.startswith("/*", i): depth += 1; i += 2
                elif src.startswith("*/", i): depth -= 1; i += 2
                else: i += 1
        elif src.startswith("/-", i):
            toks.append(("slashdash", None)); i += 2
        elif c in "{}=":
            toks.append((c, c)); i += 1
        elif c == "(":                         # type annotation: skip
            j = src.find(")", i)
            i = n if j < 0 else j + 1
        elif c == '"':
            j, out = i + 1, []
            while j < n and src[j] != '"':
                if src[j] == "\\" and j + 1 < n:
                    e = src[j + 1]
                    out.append({"n": "\n", "t": "\t", "r": "\r", '"': '"', "\\": "\\", "/": "/"}.get(e, e))
                    j += 2
                else:
                    out.append(src[j]); j += 1
            toks.append(("str", "".join(out))); i = j + 1
        else:
            m = re.match(r'r?(#+)"', src[i:])
            if m:                              # raw string r#"..."# / #"..."#
                hashes = m.group(1)
                start = i + m.end()
                end = src.find('"' + hashes, start)
                end = n if end < 0 else end
                toks.append(("str", src[start:end])); i = end + 1 + len(hashes)
                continue
            m = re.match(r'[^\s{}=;"()\\]+', src[i:])
            word = m.group(0) if m else c
            toks.append(("word", word)); i += len(word)
    return toks


def parse_nodes(toks, pos=0, line_of=None):
    """Return (nodes, pos). Node = dict(name, args, props, children)."""
    nodes = []
    n = len(toks)
    while pos < n:
        kind, val = toks[pos]
        if kind == "end":
            pos += 1; continue
        if kind == "}":
            return nodes, pos + 1
        skip = False
        if kind == "slashdash":
            skip = True; pos += 1
            while pos < n and toks[pos][0] == "end": pos += 1
            if pos >= n: break
            kind, val = toks[pos]
        node = {"name": val, "args": [], "props": {}, "children": [], "tok": pos}
        pos += 1
        while pos < n:
            k, v = toks[pos]
            if k == "end":
                pos += 1; break
            if k == "}":
                break
            if k == "slashdash":                 # drop the next entry / child block
                pos += 1
                if pos < n and toks[pos][0] == "{":
                    _, pos = parse_nodes(toks, pos + 1)
                elif pos + 2 < n and toks[pos + 1][0] == "=":
                    pos += 3
                else:
                    pos += 1
                continue
            if k == "{":
                node["children"], pos = parse_nodes(toks, pos + 1)
                continue
            if pos + 2 < n and toks[pos + 1][0] == "=":
                vk, vv = toks[pos + 2]
                node["props"][v] = vv if vk == "str" else Bare(vv)
                pos += 3
                continue
            node["args"].append(v if k == "str" else Bare(v))
            pos += 1
        if not skip:
            nodes.append(node)
    return nodes, pos


def read_kdl(path):
    with open(path, encoding="utf-8") as f:
        src = f.read()
    toks = tokenize(src)
    # line number of each token (for --check output / jump-to-source)
    lines, line = [], 1
    # cheap approximation: recount by re-scanning end tokens
    for k, v in toks:
        lines.append(line)
        if k == "end" and v == "\n":
            line += 1
    nodes, _ = parse_nodes(toks)
    return nodes, lines


def collect_binds(root, seen=None):
    """Yield (file, line, bind-node) in load order."""
    seen = seen if seen is not None else set()
    root = os.path.realpath(root)
    if root in seen or not os.path.isfile(root):
        return
    seen.add(root)
    try:
        nodes, lines = read_kdl(root)
    except OSError:
        return
    base = os.path.dirname(root)
    for node in nodes:
        if node["name"] == "include" and node["args"]:
            p = os.path.expanduser(str(node["args"][0]))
            yield from collect_binds(p if os.path.isabs(p) else os.path.join(base, p), seen)
        elif node["name"] == "binds":
            for b in node["children"]:
                yield root, lines[b["tok"]] if b["tok"] < len(lines) else 0, b

