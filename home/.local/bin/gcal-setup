#!/bin/sh
# Connect Google calendars (secret iCal links) to the desktop agenda.
#   gcal-setup            add calendars interactively
#   gcal-setup list       show configured calendars (links masked)
#   gcal-setup remove N   remove calendar N
#   gcal-setup write      optional: enable creating events (gcalcli OAuth)
exec "$HOME/.venvs/gcal/bin/python" "$HOME/.local/share/gcal-sync/gcal_sync.py" setup "$@"
