#!/usr/bin/env python3
# Disable touchpad "disable-while-typing" while a Minecraft window is focused.
# niri has no per-window dwt, so this toggles the `dwt` line in input.kdl
# (niri hot-reloads the config on change).
import json, os, re, subprocess

CFG = os.path.expanduser("~/.config/niri/user/input.kdl")
MATCH = re.compile(r"^Minecraft", re.I)  # app_id e.g. "Minecraft* 1.20.1"


def set_dwt(on: bool):
    with open(CFG) as f:
        text = f.read()
    new = re.sub(r"^(\s*)(?://\s*)?dwt\s*$", r"\1dwt" if on else r"\1// dwt", text, flags=re.M)
    if new != text:
        with open(CFG, "w") as f:
            f.write(new)


windows = {}
focused = None


def update():
    w = windows.get(focused)
    set_dwt(not (w and MATCH.search(w.get("app_id") or "")))


try:
    proc = subprocess.Popen(["niri", "msg", "--json", "event-stream"], stdout=subprocess.PIPE, text=True)
    for line in proc.stdout:
        ev = json.loads(line)
        if "WindowsChanged" in ev:
            windows = {w["id"]: w for w in ev["WindowsChanged"]["windows"]}
            focused = next((w["id"] for w in windows.values() if w.get("is_focused")), None)
        elif "WindowOpenedOrChanged" in ev:
            w = ev["WindowOpenedOrChanged"]["window"]
            windows[w["id"]] = w
            if w.get("is_focused"):
                focused = w["id"]
        elif "WindowClosed" in ev:
            windows.pop(ev["WindowClosed"]["id"], None)
        elif "WindowFocusChanged" in ev:
            focused = ev["WindowFocusChanged"]["id"]
        else:
            continue
        update()
finally:
    set_dwt(True)
