#!/usr/bin/env bash
# music-player — open the music library player (rmpc) in a floating glass kitty,
# or focus it if it is already open. Bound to Mod+Shift+M (~/.config/niri/user/binds-music.kdl);
# the window rule for app-id "music-player" lives in ~/.config/niri/user/rules-music.kdl.
#
# Closing the window never stops the music: playback runs in the MPD user service.

app_id="music-player"

# Already open? Focus it (shared helper, app-id match).
if "$HOME/.local/bin/niri-focus-or-run" "$app_id"; then
    exit 0
fi

# MPD normally starts at login; make sure it is up before the client connects.
systemctl --user start mpd.service >/dev/null 2>&1

# A slightly smaller font than the shell terminals so the library fits more rows.
exec kitty --class "$app_id" --title "Music" -o font_size=13 rmpc
