#!/usr/bin/python3
"""anki-add - add a Japanese sentence-mining note to Anki through AnkiConnect (127.0.0.1:8770).

  echo '{"expression":"約束","reading":"約束[やくそく]","meaning":"promise","sentence":"あの日の約束、覚えてる？",
         "sentence_translation":"Do you remember...","picture":"/path/crop.png","source":"jocr","tags":["jocr"]}' | anki-add
  anki-add --expression 約束 --sentence "あの日の約束、覚えてる？" [--meaning ...] [--deck Japanese::Mining]
  anki-add --flush            send queued notes (also done on every call)
  anki-add --check            AnkiConnect reachable? (exit 0/1)

Note type "JP Mining" (created if missing): Expression, Reading (Anki furigana: 漢字[かんじ]), Meaning,
Sentence (target word in <b>), SentenceTranslation, Picture, Source, Tags.  Deck default: Japanese::Mining.
If Anki is not running the note is appended to ~/.local/share/anki-queue.jsonl (picture embedded).
Output: one JSON line {"status": added|duplicate|queued|flushed|error, ...}
Exit codes: 0 added/flushed/ok, 2 duplicate, 3 queued (Anki closed), 1 error.
"""
import argparse
import base64
import fcntl
import hashlib
import json
import os
import re
import sys
import urllib.request

URL = os.environ.get("ANKI_CONNECT_URL", "http://127.0.0.1:8770")
QUEUE = os.path.expanduser(os.environ.get("ANKI_QUEUE", "~/.local/share/anki-queue.jsonl"))
DECK = "Japanese::Mining"
MODEL = "JP Mining"
FIELDS = ["Expression", "Reading", "Meaning", "Sentence", "SentenceTranslation", "Picture", "Source", "Tags"]

CSS = """
.card { font-family: "Noto Sans CJK JP", "Hiragino Sans", "Google Sans", sans-serif; font-size: 20px;
  text-align: center; color: #1f1f24; background: #f6f5fa; line-height: 1.55; padding: 18px 12px; }
.card.nightMode, .card.night_mode { color: #e4e1e9; background: #131318; }
.sentence { font-size: 30px; margin: 22px auto; max-width: 820px; }
.sentence b { color: #4f5bd5; font-weight: 700; border-bottom: 2px solid rgba(79,91,213,.35); }
.nightMode .sentence b, .night_mode .sentence b { color: #bdc2ff; border-bottom-color: rgba(189,194,255,.35); }
.expr { font-size: 40px; margin-top: 6px; }
.expr rt { font-size: 15px; color: #6d6a78; }
.nightMode .expr rt, .night_mode .expr rt { color: #a9a6b4; }
.meaning { font-size: 18px; margin: 10px auto; max-width: 680px; text-align: left; }
.trans { font-size: 17px; opacity: .78; margin: 12px auto; max-width: 760px; font-style: italic; }
.pic img { max-width: min(560px, 92%); max-height: 320px; border-radius: 14px; margin-top: 14px;
  box-shadow: 0 6px 24px rgba(0,0,0,.25); }
.src { font-size: 12px; opacity: .5; margin-top: 14px; }
hr#answer { border: none; height: 1px; background: rgba(127,127,127,.25); margin: 18px 10%; }
"""
FRONT = '<div class="sentence">{{Sentence}}</div>'
BACK = """{{FrontSide}}
<hr id=answer>
<div class="expr">{{furigana:Reading}}</div>
<div class="meaning">{{Meaning}}</div>
{{#SentenceTranslation}}<div class="trans">{{SentenceTranslation}}</div>{{/SentenceTranslation}}
{{#Picture}}<div class="pic">{{Picture}}</div>{{/Picture}}
{{#Source}}<div class="src">{{Source}}</div>{{/Source}}"""


def call(action, timeout=4, **params):
    body = json.dumps({"action": action, "version": 6, "params": params}).encode()
    req = urllib.request.Request(URL, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        d = json.load(r)
    if d.get("error"):
        raise RuntimeError(d["error"])
    return d.get("result")


def reachable():
    try:
        call("version", timeout=1.5)
        return True
    except Exception:
        return False


def ensure(deck):
    if MODEL not in call("modelNames"):
        call("createModel", modelName=MODEL, inOrderFields=FIELDS, css=CSS, isCloze=False,
             cardTemplates=[{"Name": "Mining", "Front": FRONT, "Back": BACK}])
    if deck not in call("deckNames"):
        call("createDeck", deck=deck)


def bold(sentence, word):
    if not sentence or not word or "<b>" in sentence:
        return sentence
    i = sentence.find(word)
    if i < 0:
        return sentence
    return sentence[:i] + "<b>" + word + "</b>" + sentence[i + len(word):]


def picture_b64(n):
    """-> (filename, base64) from n["picture"] (path) or n["picture_b64"]."""
    data = None
    if n.get("picture_b64"):
        data = n["picture_b64"]
    elif n.get("picture") and os.path.isfile(os.path.expanduser(n["picture"])):
        with open(os.path.expanduser(n["picture"]), "rb") as f:
            data = base64.b64encode(f.read()).decode()
    if not data:
        return None, None
    ext = os.path.splitext(n.get("picture") or "")[1].lower() or ".jpg"
    name = "jocr_" + hashlib.sha1(data.encode()).hexdigest()[:16] + ext
    return name, data


def add(n):
    deck = n.get("deck") or DECK
    ensure(deck)
    word = n.get("word") or n.get("expression", "")
    tags = n.get("tags") or []
    if isinstance(tags, str):
        tags = tags.split()
    fields = {
        "Expression": n.get("expression", ""),
        "Reading": n.get("reading", ""),
        "Meaning": n.get("meaning", ""),
        "Sentence": bold(n.get("sentence", ""), word),
        "SentenceTranslation": n.get("sentence_translation", ""),
        "Picture": "",
        "Source": n.get("source", ""),
        "Tags": " ".join(tags),
    }
    if not fields["Expression"]:
        raise ValueError("expression is required")
    # duplicate check first (no media upload for duplicates)
    q = 'deck:"%s" note:"%s" "Expression:%s"' % (deck, MODEL, fields["Expression"].replace('"', '\\"'))
    if call("findNotes", query=q):
        return {"status": "duplicate", "expression": fields["Expression"], "deck": deck}
    name, data = picture_b64(n)
    if data:
        stored = call("storeMediaFile", filename=name, data=data)
        fields["Picture"] = '<img src="%s">' % (stored or name)
    nid = call("addNote", note={"deckName": deck, "modelName": MODEL, "fields": fields, "tags": tags,
                                "options": {"allowDuplicate": False, "duplicateScope": "deck"}})
    return {"status": "added", "note_id": nid, "expression": fields["Expression"], "deck": deck}


def enqueue(n):
    n = dict(n)
    name, data = picture_b64(n)  # embed the picture: the crop file is temporary
    if data:
        n["picture_b64"] = data
        n["picture"] = name
    os.makedirs(os.path.dirname(QUEUE), exist_ok=True)
    with open(QUEUE, "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(n, ensure_ascii=False) + "\n")


def flush():
    """Send queued notes; keeps the ones that fail for other reasons than duplicates."""
    if not os.path.exists(QUEUE) or os.path.getsize(QUEUE) == 0 or not reachable():
        return 0, 0
    with open(QUEUE, "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        lines = [l for l in f.read().splitlines() if l.strip()]
        keep, sent = [], 0
        for line in lines:
            try:
                r = add(json.loads(line))
                sent += r["status"] == "added"
            except Exception:
                keep.append(line)
        f.seek(0)
        f.truncate()
        f.write("".join(l + "\n" for l in keep))
    return sent, len(keep)


def main():
    ap = argparse.ArgumentParser(prog="anki-add", formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    for k in ("expression", "word", "reading", "meaning", "sentence", "sentence-translation", "picture", "source", "deck"):
        ap.add_argument("--" + k)
    ap.add_argument("--tags", help="space separated")
    ap.add_argument("--flush", action="store_true")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--quiet", action="store_true")
    a = ap.parse_args()

    def out(obj, code):
        if not (a.quiet and code == 0):
            print(json.dumps(obj, ensure_ascii=False))
        return code

    if a.check:
        ok = reachable()
        return out({"status": "ok" if ok else "down", "url": URL}, 0 if ok else 1)
    if a.flush:
        sent, left = flush()
        return out({"status": "flushed", "sent": sent, "queued": left}, 0)

    if a.expression:
        n = {k: v for k, v in {"expression": a.expression, "word": a.word, "reading": a.reading, "meaning": a.meaning,
                               "sentence": a.sentence, "sentence_translation": a.sentence_translation,
                               "picture": a.picture, "source": a.source, "deck": a.deck,
                               "tags": a.tags.split() if a.tags else None}.items() if v}
    else:
        try:
            n = json.load(sys.stdin)
        except ValueError as e:
            return out({"status": "error", "message": f"bad JSON on stdin: {e}"}, 1)
    if not reachable():
        enqueue(n)
        return out({"status": "queued", "expression": n.get("expression", ""), "queue": QUEUE}, 3)
    try:
        flush()
        r = add(n)
    except Exception as e:
        return out({"status": "error", "message": str(e)}, 1)
    return out(r, 2 if r["status"] == "duplicate" else 0)


if __name__ == "__main__":
    sys.exit(main())
