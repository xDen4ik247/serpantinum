[Unit]
Description=Local LLM on demand - proxy 127.0.0.1:8765 -> llama-server (npu-llm-server.service), exits when idle
Documentation=file:///home/user/claude/.workers/reports/battery.md file:///home/user/claude/.workers/reports/llm-api.md
# battery worker 2026-10-09: started by npu-llm.socket on the first connection. After NPU_LLM_IDLE without any open
# connection the proxy exits, npu-llm-server.service becomes unneeded and stops (frees ~7 GB RAM + GPU buffers).
# `systemctl --user start npu-llm` still warms the model up by hand; `stop npu-llm.socket` turns the LLM off fully.
Requires=npu-llm-server.service
After=npu-llm-server.service

[Service]
Type=simple
# idle time: 30 min on AC, 10 min on battery (written by `power-mode` to llm.env; read at each start)
Environment=NPU_LLM_IDLE=30min
EnvironmentFile=-%h/.local/state/power-mode/llm.env
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=${NPU_LLM_IDLE} 127.0.0.1:18765
