[Unit]
Description=glass-smart-charge: hold the battery at 80 % on AC, charge to 100 % when you'll need it (like iPhone Optimized Charging)
Documentation=https://github.com/xDen4ik247/serpantinum/blob/glass/rust/src/bin/glass-smart-charge.rs
After=default.target

[Service]
Type=simple
# listens to UPower's OnBattery on the system bus; decides every 5 min on AC, hourly on battery, and on plug/unplug
ExecStart=%h/.local/bin/glass-smart-charge daemon
Restart=on-failure
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
