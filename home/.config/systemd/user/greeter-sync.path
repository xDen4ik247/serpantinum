[Unit]
Description=Watch the Serpantinum wallpaper/palette for the serp-glass greeter

[Path]
# the glass installer puts this machine's main display here (e.g. eDP-1)
PathChanged=%h/.cache/serpantinum/wallpaper/current_@GLASS_OUTPUT@
PathChanged=%h/.local/state/serpantinum/qs_colors.json
PathChanged=%h/.config/serp-glass/greeter.conf
TriggerLimitIntervalSec=10
TriggerLimitBurst=3

[Install]
WantedBy=default.target
