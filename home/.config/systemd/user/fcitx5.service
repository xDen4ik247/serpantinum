[Unit]
Description=Fcitx5 input method (EN/RU/Mozc) — single instance, restarts itself if it dies
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/fcitx5 --replace
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
