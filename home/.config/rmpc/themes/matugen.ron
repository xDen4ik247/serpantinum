#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// rmpc theme that follows the wallpaper: it only uses the 16 terminal palette slots,
// which Serpantinum's Matugen writes into ~/.config/kitty/colors.conf. The kitty
// background stays see-through (liquid glass), so no background colours are set.
//
// slot (rmpc name)          Matugen role
//  0  black                 surface_variant      8  dark_gray       outline
//  1  red                   error                9  light_red       error_container
//  2  green                 primary             10  light_green     primary_fixed
//  3  yellow                tertiary            11  light_yellow    tertiary_fixed
//  4  blue                  secondary           12  light_blue      secondary_fixed
//  5  magenta               primary_container   13  light_magenta   inverse_primary
//  6  cyan                  secondary_container 14  light_cyan      tertiary_container
//  7  gray                  on_surface_variant  15  white           on_surface
(
    default_album_art_path: None,
    format_tag_separator: " · ",
    browser_column_widths: [22, 36, 42],
    background_color: None,
    text_color: None,
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "yellow"),
    preview_metadata_group_style: (fg: "green", modifiers: "Bold"),
    // The song that is playing right now (in the queue and the browsers).
    highlighted_item_style: (fg: "green", modifiers: "Bold"),
    // The cursor row: the same primary pill as the starship prompt.
    current_item_style: (fg: "light_green", bg: "magenta", modifiers: "Bold"),
    borders_style: (fg: "dark_gray"),
    highlight_border_style: (fg: "green"),
    symbols: (
        song: "󰝚",
        dir: "󰉋",
        playlist: "󰲸",
        marker: "󰄲",
        ellipsis: "…",
        song_style: (fg: "gray"),
        dir_style: (fg: "yellow"),
        playlist_style: (fg: "blue"),
    ),
    level_styles: (
        info: (fg: "green"),
        warn: (fg: "yellow"),
        error: (fg: "red"),
        debug: (fg: "blue"),
        trace: (fg: "gray"),
    ),
    progress_bar: (
        symbols: ["━", "━", "●", "─", "─"],
        track_style: (fg: "black"),
        elapsed_style: (fg: "green"),
        thumb_style: (fg: "light_green"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "┃", " ", " "],
        track_style: (fg: "black"),
        ends_style: (),
        thumb_style: (fg: "green"),
    ),
    tab_bar: (
        active_style: (fg: "light_green", bg: "magenta", modifiers: "Bold"),
        inactive_style: (fg: "gray"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text("  ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Title), style: (modifiers: "Bold"),
                default: (kind: Property(Filename))
            ),
            label_prop: (kind: Text("Title")),
            width: "40%",
        ),
        (
            prop: (kind: Property(Artist), style: (fg: "yellow"),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "25%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "gray"),
                default: (kind: Text("Unknown Album"), style: (fg: "gray"))
            ),
            label_prop: (kind: Text("Album")),
            width: "25%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "dark_gray"),
                default: (kind: Text("-"))
            ),
            label_prop: (kind: Text("Time")),
            width: "10%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "30",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "30",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "RIGHT | LEFT | BOTTOM",
                border_symbols: Rounded,
                size: "2",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs · ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" "))],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text(" "), style: (fg: "green", modifiers: "Bold")),
                (kind: Property(Status(StateV2(playing_label: "󰐊 Playing", paused_label: "󰏤 Paused", stopped_label: "󰓛 Stopped"))), style: (fg: "green", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "white", modifiers: "Bold"),
                    default: (kind: Text("Nothing playing"), style: (fg: "gray", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "━", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "green"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "green"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Text(" ")),
                (kind: Property(Status(Elapsed)), style: (fg: "gray")),
                (kind: Text(" / "), style: (fg: "dark_gray")),
                (kind: Property(Status(Duration)), style: (fg: "gray")),
                (kind: Group([
                    (kind: Text("  ")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps")),
                ]), style: (fg: "dark_gray")),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "yellow", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "yellow", modifiers: "Bold"))),
                (kind: Text("  ·  "), style: (fg: "dark_gray")),
                (kind: Property(Song(Album)), style: (fg: "gray"), default: (kind: Text("Unknown Album"), style: (fg: "gray"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "green"), align: Left)]))
                ),
                (
                    size: "10",
                    pane: Pane(Property(content: [
                        (kind: Property(Status(RepeatV2(
                            on_label: " 󰑖",
                            off_label: " 󰑖",
                            on_style: (fg: "light_green", modifiers: "Bold"),
                            off_style: (fg: "dark_gray"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: " 󰒝",
                            off_label: " 󰒝",
                            on_style: (fg: "light_green", modifiers: "Bold"),
                            off_style: (fg: "dark_gray"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: " 󰆴",
                            off_label: " 󰆴",
                            oneshot_label: " 󰆴",
                            on_style: (fg: "light_green", modifiers: "Bold"),
                            off_style: (fg: "dark_gray"),
                            oneshot_style: (fg: "yellow", modifiers: "Bold"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: " 󰑘",
                            off_label: " 󰑘",
                            oneshot_label: " 󰑘",
                            on_style: (fg: "light_green", modifiers: "Bold"),
                            off_style: (fg: "dark_gray"),
                            oneshot_style: (fg: "yellow", modifiers: "Bold"),
                        )))),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "light_green", bg: "magenta", modifiers: "Bold"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "light_yellow", bg: "light_cyan", modifiers: "Bold"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "100%", pane: Pane(ProgressBar)),
                (size: "1", pane: Pane(Empty())),
            ]
        )
    },
)
