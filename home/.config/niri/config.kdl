// Serpantinum's own files (config/) are kept exactly as upstream ships them;
// `serp-tweaks sync` refreshes them after every update. Never edit them by hand.
include "config/env.kdl"
include "config/input.kdl"
include "config/layout.kdl"
include "config/autostart.kdl"
// Not included on purpose: config/output.kdl and config/keybinds.kdl.
// niri can't unbind keys, so the keymap and the display live fully in user/.

// Personal layer: loaded last, so it overrides the files above.
include "user/env.kdl"
include "user/input.kdl"
