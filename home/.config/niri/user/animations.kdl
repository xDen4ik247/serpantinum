// Juicy animations. Springs slightly under 1.0 damping give a small, quick
// settle instead of a dead stop; niri renders them at the panel's full 120 Hz.
animations {
    workspace-switch {
        spring damping-ratio=0.9 stiffness=900 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.86 stiffness=720 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.8 stiffness=650 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.84 stiffness=700 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=0.85 stiffness=720 epsilon=0.0001
    }

    // Open: rise up and pop in. The spring overshoots a little, so the window
    // swells just past full size before settling.
    window-open {
        spring damping-ratio=0.7 stiffness=480 epsilon=0.001
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_progress;
                float scale = 0.86 + 0.14 * p;
                vec2 xy = (coords_geo.xy - vec2(0.5)) / scale + vec2(0.5);
                xy.y += (1.0 - p) * 28.0 / size_geo.y;
                if (xy.x < 0.0 || xy.x > 1.0 || xy.y < 0.0 || xy.y > 1.0)
                    return vec4(0.0);
                vec3 coords_tex = niri_geo_to_tex * vec3(xy, 1.0);
                float a = clamp(niri_clamped_progress * 1.6, 0.0, 1.0);
                return texture2D(niri_tex, coords_tex.st) * a;
            }
        "
    }

    // Close: shrink, sink and fade quickly, so the neighbours can glide in.
    window-close {
        duration-ms 220
        curve "cubic-bezier" 0.3 0.0 0.2 1.0
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = 1.0 - 0.1 * p;
                vec2 xy = (coords_geo.xy - vec2(0.5)) / scale + vec2(0.5);
                xy.y -= p * 24.0 / size_geo.y;
                if (xy.x < 0.0 || xy.x > 1.0 || xy.y < 0.0 || xy.y > 1.0)
                    return vec4(0.0);
                vec3 coords_tex = niri_geo_to_tex * vec3(xy, 1.0);
                float a = 1.0 - p;
                return texture2D(niri_tex, coords_tex.st) * a * a;
            }
        "
    }
}
