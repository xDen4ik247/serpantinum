// Device sections replace upstream's completely, so they're spelled out in full.
// niri-dwt-toggle flips the `dwt` line below while Minecraft is focused.
input {
    keyboard {
        xkb {
            // us/ru/mozc switching (Alt+Shift) is handled by fcitx5
            layout "us"
        }
    }
    touchpad {
        tap
        dwt
        natural-scroll
        accel-profile "flat"
        click-method "clickfinger"
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
    hide-when-typing
}
