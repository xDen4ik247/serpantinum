// Rounded corners to match Serpantinum's rounded UI.
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

// Firefox Picture-in-Picture floats.
window-rule {
    match app-id=r#"^(firefox|org\.mozilla\.firefox)$"# title="^Picture-in-Picture$"
    open-floating true
}

// Variable refresh rate while Minecraft is on screen.
window-rule {
    match app-id="^Minecraft"
    variable-refresh-rate true
}

// ── Liquid glass terminals ──────────────────────────────────────────────────
// kitty draws a see-through background (kitty/user.conf); niri blurs and boosts
// the wallpaper behind it, adds a bright hairline rim and a soft drop shadow.
// The rim is brighter on the focused terminal, so it replaces the focus ring.
window-rule {
    match app-id="^(kitty|claude)$"
    background-effect {
        blur true
        saturation 1.9
        noise 0.03
    }
    draw-border-with-background false
    focus-ring { off; }
    border {
        on
        width 1.5
        active-gradient from="#ffffffb0" to="#ffffff26" angle=150
        inactive-gradient from="#ffffff4d" to="#ffffff10" angle=150
    }
    shadow {
        on
        softness 36
        spread 2
        offset x=0 y=6
        color "#0000006a"
    }
}
