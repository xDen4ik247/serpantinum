// Window/layer rules owned by the music feature.

// The library player (rmpc in `kitty --class music-player`, opened by Mod+Shift+M):
// a floating liquid-glass window, the same glass as the terminals in rules.kdl.
window-rule {
    match app-id="^music-player$"
    open-floating true
    default-column-width { fixed 1180; }
    default-window-height { fixed 740; }

    background-effect {
        blur true
        saturation 1.9
        noise 0.03
    }
    draw-border-with-background false
    focus-ring { off; }
    border {
        on
        width 1.5
        active-gradient from="#ffffffb0" to="#ffffff26" angle=150
        inactive-gradient from="#ffffff4d" to="#ffffff10" angle=150
    }
    shadow {
        on
        softness 36
        spread 2
        offset x=0 y=6
        color "#0000006a"
    }
}

// Glass Music (glass-music, ~/Projects/glass-music; Mod+Shift+M): the Spotify-style library
// app. A regular tiled window (in Alt-Tab / overview). The app paints a translucent Matugen
// tint; niri blurs what is behind it and draws the kitty-style hairline rim and soft shadow.
window-rule {
    match app-id=r#"^glass-music$"#
    geometry-corner-radius 20
    clip-to-geometry true
    background-effect {
        blur true
        saturation 1.9
        noise 0.03
    }
    draw-border-with-background false
    focus-ring { off; }
    border {
        on
        width 1.5
        active-gradient from="#ffffffb0" to="#ffffff26" angle=150
        inactive-gradient from="#ffffff4d" to="#ffffff10" angle=150
    }
    shadow {
        on
        softness 36
        spread 2
        offset x=0 y=6
        color "#0000006a"
    }
}

// Test runs (GLASS_MUSIC_TITLE="Glass Music (test)") never steal keyboard focus.
window-rule {
    match app-id=r#"^glass-music$"# title=r#"^Glass Music \(test\)$"#
    open-focused false
}
